# /etc/cathedral/sealed-hotels-renew.env (mode 600). Names only; no secret values here.
CATHEDRAL_SANDBOX_DIR=/opt/cathedral-sandbox
SEALED_HOTELS_SIGNER_CONFIG=/path/to/signers.json
SEALED_HOTELS_INVENTORY=/var/lib/cathedral-sealed-hotels/inventory.json
SEALED_HOTELS_STATE=/var/lib/cathedral-sealed-hotels/publisher-state.json
SEALED_HOTELS_OUT_DIR=/var/lib/cathedral-sealed-hotels/releases
SEALED_HOTELS_LIFETIME_HOURS=24
CLOUDFLARE_ACCOUNT_ID=
# Namespace bound as SEALED_HOTELS_STORE in cathedral-site wrangler.jsonc.
SEALED_HOTELS_KV_NAMESPACE_ID=
# File (mode 600) holding a token scoped to Workers KV Storage:Edit on that account.
CLOUDFLARE_API_TOKEN_FILE=/path/to/cloudflare-kv-sealed-hotels-token
