# Opt-in TEE box layer (T6b1). NOT a production image and not published.
#
# It adds a pinned, checksum-verified gVisor runsc to an SN94 miner image that
# was already built from Dockerfile.sn94-audit-miner (TDX) or
# Dockerfile.sn94-snp-miner (SNP). The production images stay unchanged until
# T6b2 qualifies runsc under real TDX and SNP guests (docs/TEE_BOX_SERVICE.md).
#
#   docker build -f Dockerfile.tee-box-runsc \
#     --build-arg MINER_IMAGE=<miner image>@sha256:<digest> .
#
# MINER_IMAGE has no default and must name a digest, so the base is explicit.
ARG MINER_IMAGE

# The fetch stage uses the same pinned linux/amd64 base as the miner images.
FROM python:3.12-slim-bookworm@sha256:4427763a1ba36f5aa8f656a03e5d00f3b8d61f5dd950c73df6c14f8c7640f8ab AS runsc
ARG MINER_IMAGE
RUN case "${MINER_IMAGE}" in *@sha256:????????????????????????????????????????????????????????????????) ;; *) echo "MINER_IMAGE must be pinned by sha256 digest" >&2; exit 1;; esac

# gVisor release-20261005.0, the first release with the fixes for two public
# guest-to-host escapes (Oct 2026). Releases after 20260817.0 ship as one
# tarball: runsc plus the gvisor-bin/ sidecars it resolves next to itself.
# The build checks the tarball against Google's published sha512, keeps only
# runsc and gvisor-bin/, and checks runsc against the pinned sha256.
RUN python -c "import hashlib,pathlib,tarfile,urllib.request; url='https://storage.googleapis.com/gvisor/releases/release/20261005.0/x86_64/gvisor.tar.bz2'; tarball=pathlib.Path('/tmp/gvisor.tar.bz2'); urllib.request.urlretrieve(url, tarball); expected_tarball='79869ae9a589355a46d46fdac068d9a954e741741ffe77c64e38c56ea955498c1cb04e9bce44e1cce5155333e6b76bee72347c6661bb7c78fd2fe3aad198c8fe'; assert hashlib.sha512(tarball.read_bytes()).hexdigest() == expected_tarball, 'pinned gvisor tarball digest mismatch'; out=pathlib.Path('/opt/gvisor'); out.mkdir(); archive=tarfile.open(tarball); members=[m for m in archive.getmembers() if m.name in ('runsc', 'gvisor-bin') or m.name.startswith('gvisor-bin/')]; assert all(m.isfile() or m.isdir() for m in members), 'unexpected tar member type'; archive.extractall(out, members=members, filter='data'); archive.close(); tarball.unlink(); expected='210b437a9cfae51e8f8c9074ed19b8b5e59477178e2e391a18117d8d6b924f7a'; digest=hashlib.sha256((out / 'runsc').read_bytes()); assert digest.hexdigest() == expected, 'pinned runsc digest mismatch'; [path.chmod(0o555) for path in out.rglob('*') if path.is_file()]"

FROM ${MINER_IMAGE}
LABEL org.cathedral.tee-box.runsc="release-20261005.0" \
      org.cathedral.tee-box.runsc-sha256="210b437a9cfae51e8f8c9074ed19b8b5e59477178e2e391a18117d8d6b924f7a" \
      org.cathedral.tee-box.gvisor-tarball-sha512="79869ae9a589355a46d46fdac068d9a954e741741ffe77c64e38c56ea955498c1cb04e9bce44e1cce5155333e6b76bee72347c6661bb7c78fd2fe3aad198c8fe"
COPY --from=runsc /opt/gvisor/ /usr/local/bin/
