# Opt-in TEE box layer (T6b1). NOT a production image and not published.
#
# It adds a pinned, checksum-verified gVisor runsc to an SN94 miner image that
# was already built from Dockerfile.sn94-audit-miner (TDX) or
# Dockerfile.sn94-snp-miner (SNP). The production images stay unchanged until
# T6b2 qualifies runsc under real TDX and SNP guests (docs/TEE_BOX_SERVICE.md).
#
#   docker build -f Dockerfile.tee-box-runsc \
#     --build-arg MINER_IMAGE=<miner image>@sha256:<digest> .
#
# MINER_IMAGE has no default and must name a digest, so the base is explicit.
ARG MINER_IMAGE

# The fetch stage uses the same pinned linux/amd64 base as the miner images.
FROM python:3.12-slim-bookworm@sha256:4427763a1ba36f5aa8f656a03e5d00f3b8d61f5dd950c73df6c14f8c7640f8ab AS runsc
ARG MINER_IMAGE
RUN case "${MINER_IMAGE}" in *@sha256:????????????????????????????????????????????????????????????????) ;; *) echo "MINER_IMAGE must be pinned by sha256 digest" >&2; exit 1;; esac

# gVisor release-20261005.0 ships gvisor.tar.zstd (bare runsc URL is 404).
# sha256 is of the extracted runsc binary (matches Cherry measured images).
RUN apt-get update \
 && apt-get install -y --no-install-recommends zstd \
 && rm -rf /var/lib/apt/lists/* \
 && python <<'PY'
import hashlib
import io
import pathlib
import subprocess
import tarfile
import urllib.request

url = "https://storage.googleapis.com/gvisor/releases/release/20261005.0/x86_64/gvisor.tar.zstd"
expected = "210b437a9cfae51e8f8c9074ed19b8b5e59477178e2e391a18117d8d6b924f7a"
raw = urllib.request.urlopen(url).read()
dec = subprocess.check_output(["zstd", "-d", "-c"], input=raw)
with tarfile.open(fileobj=io.BytesIO(dec), mode="r:") as tf:
    data = tf.extractfile(tf.getmember("runsc")).read()
digest = hashlib.sha256(data).hexdigest()
assert digest == expected, f"pinned runsc digest mismatch: {digest}"
path = pathlib.Path("/usr/local/bin/runsc")
path.write_bytes(data)
path.chmod(0o555)
PY

FROM ${MINER_IMAGE}
LABEL org.cathedral.tee-box.runsc="release-20261005.0" \
      org.cathedral.tee-box.runsc-sha256="210b437a9cfae51e8f8c9074ed19b8b5e59477178e2e391a18117d8d6b924f7a"
COPY --from=runsc /usr/local/bin/runsc /usr/local/bin/runsc
