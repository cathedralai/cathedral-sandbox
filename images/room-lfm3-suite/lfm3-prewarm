#!/usr/bin/env bash
# lfm3-prewarm: run once at image build. Starts this image's model server,
# reads lfm3-agent's default system prompt and tools, and saves the server's
# state to $LFM3_SLOT_DIR/warm.bin with the request's sha256 in warm.sha256.
# At boot lfm3-agent --warm restores it when its request is the same, so a new
# room is ready for its first liquid about 4.7 s sooner (sealed 2 vCPU room).
# The room's working directory is /work, so the saved prompt names it.
set -euo pipefail

slot_dir=${LFM3_SLOT_DIR:-/opt/lfm3/cache}
mkdir -p "$slot_dir"
tmp=$(mktemp -d)
LFM3_SLOT_DIR=$slot_dir lfm3-serve >"$tmp/server.log" 2>&1 &
pid=$!
trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rm -rf "$tmp"' EXIT

if ! LFM3_SLOT_DIR=$slot_dir LFM3_WARM_SAVE=1 LFM3_AGENT_DIR=$tmp/agent LFM3_AGENT_CWD=/work LFM3_WAIT=300 \
  lfm3-agent --warm; then
  tail -n 40 "$tmp/server.log" >&2
  exit 1
fi
test -s "$slot_dir/warm.bin" && test -s "$slot_dir/warm.sha256"
