#!/usr/bin/env bash
# lfm3-serve [command ...]: start the model this room carries, then run the
# command. With no command the server runs in the foreground.
#
#   llama-server on 127.0.0.1:8080, OpenAI-compatible at /v1, model "$MODEL"
#   ($MODEL_BASE_URL, $MODEL, $MODEL_API_KEY). A decision model (d1) answers
#   typed questions at /v1/systemone instead of /v1/chat/completions.
#
# With a command, such as the sandbox keepalive "sleep infinity", the server
# starts in the background and logs to $LFM3_LOG_DIR/server.log (default
# /tmp/lfm3). Its /health answers 200 once the model is loaded.
#
#   lfm3-gateway on 127.0.0.1:8642 (chat models, not base): the Polaris
#   runtime chat contract, POST /v1/chat/completions with SSE and GET /health,
#   in front of lfm3-agent (AB#539). It logs to $LFM3_LOG_DIR/gateway.log.
#
# Environment:
#   LFM3_THREADS     CPU threads (default: all cores)
#   LFM3_SERVER_CTX  context size in tokens (default 4096, 8192 for d1)
#   LFM3_REASONING   off (default, short answers) or on
#   LFM3_CACHE_RAM   prompt cache in MiB (default 256; the server's own
#                    default of 8 GiB does not fit a 4 GiB room)
#   LFM3_SLOT_DIR    saved prompt cache (default /opt/lfm3/cache, written at
#                    image build by lfm3-prewarm)
#   LFM3_BATCH       d1 only: batch and micro-batch size (default 4096). A
#                    question is read in one batch; a picture takes at most
#                    half of it.
#   LFM3_GATEWAY     off: no chat gateway (lfm3-prewarm sets it at build)
set -euo pipefail

args=(
  -m "$LFM3_MODEL"
  --host 127.0.0.1
  --port 8080
  --alias "$MODEL"
  --threads "${LFM3_THREADS:-$(nproc)}"
  --parallel 1
  --no-ui
)
if [ -n "${LFM3_MMPROJ:-}" ]; then
  args+=(--mmproj "$LFM3_MMPROJ")
fi
if [ "${LFM3_KIND:-chat}" = decision ]; then
  batch=${LFM3_BATCH:-4096}
  args+=(--ctx-size "${LFM3_SERVER_CTX:-8192}" --batch-size "$batch" --ubatch-size "$batch")
else
  # --swa-full: LFM3 attends over a 256-token sliding window, and with the
  # default window-sized cache llama-server b11960 judges every saved state of
  # the prompt unusable, so it read the whole prompt again on each request
  # (cache_n 0 even on an identical request: 385 tokens, about 5 s on 2 CPUs,
  # sealed room, 4 Nov 2026). With the full-size cache a repeated prefix costs
  # a few tokens.
  args+=(
    --ctx-size "${LFM3_SERVER_CTX:-4096}"
    --reasoning "${LFM3_REASONING:-off}"
    --cache-ram "${LFM3_CACHE_RAM:-256}"
    --swa-full
  )
fi

# lfm3-prewarm saves the warm prompt cache here at image build; lfm3-agent
# --warm restores it at boot.
slot_dir=${LFM3_SLOT_DIR:-/opt/lfm3/cache}
if [ "${LFM3_KIND:-chat}" = chat ] && [ -d "$slot_dir" ]; then
  args+=(--slot-save-path "$slot_dir")
fi

log_dir=${LFM3_LOG_DIR:-/tmp/lfm3}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# The chat gateway answers 503 on /health until llama-server is up, so it can
# start first. A decision or base model has no chat harness behind it.
start_gateway() {
  [ "${LFM3_GATEWAY:-on}" != off ] || return 0
  [ "${LFM3_KIND:-chat}" = chat ] || return 0
  [[ "${MODEL:-}" != *-base ]] || return 0
  local gateway agent=$here/lfm3-agent
  gateway=$here/lfm3-gateway
  if [ ! -x "$gateway" ]; then
    gateway=$(command -v lfm3-gateway) || return 0
  fi
  [ -x "$agent" ] || agent=lfm3-agent
  # The model server matters more than the gateway: never fail on its log.
  mkdir -p "$log_dir" 2>/dev/null || return 0
  LFM3_GATEWAY_AGENT=${LFM3_GATEWAY_AGENT:-$agent} "$gateway" >>"$log_dir/gateway.log" 2>&1 </dev/null &
}
start_gateway

if [ "$#" -eq 0 ]; then
  exec llama-server "${args[@]}"
fi

mkdir -p "$log_dir"
llama-server "${args[@]}" >"$log_dir/server.log" 2>&1 &
# Read lfm3-agent's system prompt and tools into the cache once, so the first
# liquid in a new room starts from it (about 4 s on 2 CPUs otherwise).
if [ "${LFM3_KIND:-chat}" = chat ] && [[ "${MODEL:-}" != *-base ]]; then
  agent=$here/lfm3-agent
  [ -x "$agent" ] || agent=lfm3-agent
  "$agent" --warm >"$log_dir/warm.log" 2>&1 </dev/null &
fi
exec "$@"
