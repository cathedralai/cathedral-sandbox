#!/usr/bin/env bash
# lfm3-selftest [check ...]: ask this room's model questions with known
# answers, using the files in /opt/lfm3/test. With no check it runs every
# check in $LFM3_CHECKS (set per model in the image). Prints each answer and
# its timing line, then "ok <check>"; exits 1 on the first wrong answer.
#
#   text          lfm3-ask "What is 2+2? Answer in one word."      4
#   raw           lfm3-ask --raw "The capital of France is"        Paris
#   image         lfm3-ask --image test-image.png, circle color    blue
#   audio         lfm3-ask --audio test-speech.wav, ASR            Paris
#   decide-text   lfm3-decide, refund request (noul)               yes
#   decide-image  lfm3-decide --image test-image.png, circle color blue
#   decide-audio  lfm3-decide --audio test-speech.wav, train city  paris
#   agent         lfm3-agent, "What is the hostname?"              the hostname,
#                 which the model can only learn by calling run
#   rhyme         lfm3-agent --no-tools, three rhyme requests that  no loop (one
#                 looped under greedy decoding (ADO 523)           retry each)
#   agent-audio   lfm3-agent --audio test-speech.wav: no message   no raw tool-call
#                 (tools on), then "what is said" (--no-tools)     markup; Paris
#   json          lfm3-agent --no-tools, a JSON array of 15        it parses: 15
#                 objects (a repeat penalty can break long         objects with id,
#                 structured output)                               name and color
#   json-flag     liquid --json, the same request (Audio: its      the whole answer
#                 lists can carry // comments, ADO 547)            parses, as in json
#   speak         liquid --speak: say one fixed sentence, then     a WAV that Audio
#                 hear the WAV back (ASR, lfm3-ask)                or Omni hears as
#                                                                  the same words
#
# test-speech.wav says "The train to Paris leaves at nine in the morning."
set -euo pipefail

dir=${LFM3_TEST_DIR:-/opt/lfm3/test}
checks=("$@")
if [ "${#checks[@]}" -eq 0 ]; then
  read -r -a checks <<<"${LFM3_CHECKS:-}"
fi
if [ "${#checks[@]}" -eq 0 ]; then
  echo "lfm3-selftest: no checks (set LFM3_CHECKS or name them)" >&2
  exit 2
fi

# The answer is every line but the last (the timing line).
answer_is() { # check pattern output
  printf '%s\n' "$3"
  if sed '$d' <<<"$3" | grep -Eiq "$2"; then
    echo "ok $1"
  else
    echo "FAIL $1: the answer does not match /$2/"
    exit 1
  fi
}

decision_is() { # check jq-filter output
  printf '%s\n' "$3"
  if head -n 1 <<<"$3" | jq -e "$2" >/dev/null; then
    echo "ok $1"
  else
    echo "FAIL $1: the answers do not satisfy $2"
    exit 1
  fi
}

refund='{"state": "I was charged twice this month, please refund one of them.",
  "questions": {"refund": {"type": "noul", "instructions": "Is the customer asking for a refund?"}}}'
color='{"state": null, "questions": {"color": {"type": "choice", "instructions": "What color is the circle?",
  "criteria": {"red": "Red", "green": "Green", "blue": "Blue"}}}}'
city='{"state": null, "questions": {"city": {"type": "choice", "instructions": "Which city is the train going to?",
  "criteria": {"paris": "Paris", "london": "London", "tokyo": "Tokyo"}}}}'

for check in "${checks[@]}"; do
  case "$check" in
    text) answer_is "$check" '\b(4|four)\b' "$(lfm3-ask 'What is 2+2? Answer in one word.')" ;;
    raw) answer_is "$check" 'paris' "$(LFM3_MAX_TOKENS=16 lfm3-ask --raw 'The capital of France is')" ;;
    image) answer_is "$check" 'blue' "$(lfm3-ask --image "$dir/test-image.png" 'What color is the circle? Answer in one word.')" ;;
    audio) answer_is "$check" 'paris' "$(lfm3-ask --system 'Perform ASR in English.' --audio "$dir/test-speech.wav")" ;;
    decide-text) decision_is "$check" '.refund.noul > 0.5' "$(lfm3-decide "$refund")" ;;
    decide-image) decision_is "$check" '.color.choice == "blue"' "$(lfm3-decide --image "$dir/test-image.png" "$color")" ;;
    decide-audio) decision_is "$check" '.city.choice == "paris"' "$(lfm3-decide --audio "$dir/test-speech.wav" "$city")" ;;
    rhyme)
      # Each request is a fresh conversation in its own empty directory, with
      # --no-tools: this checks decoding loops (ADO 523), not a model's choice
      # to call a tool first (Audio calls one for most messages). The loop
      # guard prints its
      # "kept repeating itself" line when an answer loops. Sampling is random,
      # so a request gets one more try: greedy decoding, the bug this guards,
      # looped on every try.
      for ask in 'rhyme with me' 'what rhymes with time' 'write an endless rhyme'; do
        good=""
        for try in 1 2; do
          agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
          out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work lfm3-agent --no-tools "$ask" 2>&1) || true
          printf '%s\n' "> $ask (try $try)" "$out"
          if [ -n "$out" ] && ! grep -q 'kept repeating itself' <<<"$out"; then
            good=1
            break
          fi
        done
        if [ -z "$good" ]; then
          echo "FAIL $check: \"$ask\" looped or gave no answer twice"
          exit 1
        fi
      done
      echo "ok $check"
      ;;
    json)
      # A count-based repeat penalty is hardest on long structured output
      # (repeated keys, braces and commas), so the array must still parse. It
      # may sit in a code fence: take the text from the first [ to the last ].
      agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
      out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work LFM3_MAX_TOKENS=900 lfm3-agent --no-tools \
        'Return a JSON array of 15 objects. Each object has "id" (1 to 15), "name" (a fruit) and "color". Reply with the JSON only.' 2>&1) || true
      printf '%s\n' "$out"
      if jq -e -Rs 'capture("(?<a>\\[[\\s\\S]*\\])").a | fromjson
          | type == "array" and length == 15
            and all(.[]; type == "object" and has("id") and has("name") and has("color"))' >/dev/null 2>&1 <<<"$out"; then
        echo "ok $check"
      else
        echo "FAIL $check: the answer is not a JSON array of 15 objects with id, name and color"
        exit 1
      fi
      ;;
    json-flag)
      # The same request through liquid --json, which holds the reply to JSON
      # syntax. The whole answer must parse, with no fence or text around it.
      agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
      out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work LFM3_MAX_TOKENS=900 liquid --json \
        'Return a JSON array of 15 objects. Each object has "id" (1 to 15), "name" (a fruit) and "color". Reply with the JSON only.' 2>"$agent_dir/stderr") || true
      cat "$agent_dir/stderr"
      printf '%s\n' "$out"
      if jq -e 'type == "array" and length == 15
          and all(.[]; type == "object" and has("id") and has("name") and has("color"))' >/dev/null 2>&1 <<<"$out"; then
        echo "ok $check"
      else
        echo "FAIL $check: the answer is not a JSON array of 15 objects with id, name and color"
        exit 1
      fi
      ;;
    speak)
      # The Talk path: an answer in text, then its speech (llama-server /tts)
      # as a WAV, heard back by the same model. Words are compared after
      # number words become digits (ASR writes "9" for "nine"): 90% of the
      # answer's words must be heard and 90% of what is heard must be in the
      # answer, so a cut or babbling WAV fails.
      agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
      wav=$agent_dir/work/reply.wav
      out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work liquid --no-tools --speak "$wav" \
        'Repeat this sentence exactly, and say nothing else: The train to Paris leaves at nine in the morning.' 2>"$agent_dir/stderr") || true
      cat "$agent_dir/stderr"
      printf '%s\n' "> said" "$out"
      heard=""
      if [ "$(head -c 4 "$wav" 2>/dev/null)" = RIFF ]; then
        heard=$(lfm3-ask --system 'Perform ASR in English.' --audio "$wav" 2>/dev/null | sed '$d') || true
      fi
      printf '%s\n' "> heard" "$heard"
      if [ -n "$heard" ] && jq -en --arg said "$out" --arg heard "$heard" '
          def words: ascii_downcase | [scan("[a-z0-9]+")]
            | map({"zero": "0", "one": "1", "two": "2", "three": "3", "four": "4", "five": "5", "six": "6",
                   "seven": "7", "eight": "8", "nine": "9", "ten": "10", "twenty": "20"}[.] // .);
          def share($a; $b): ([$a[] | select(. as $w | any($b[]; . == $w))] | length) * 10 >= ($a | length) * 9;
          ($said | words) as $s | ($heard | words) as $h
          | ($s | length) > 0 and any($s[]; . == "paris") and share($s; $h) and share($h; $s)' >/dev/null; then
        echo "ok $check"
      else
        echo "FAIL $check: no WAV, or the speech does not hold the answer's words"
        exit 1
      fi
      ;;
    agent-audio)
      # A clip with no message, tools on: any answer, never raw tool-call
      # markup (the Talk fork saw <tool_call> text here). Then the clip with a
      # question and --no-tools: the answer must hold what is said (with tools,
      # Audio often calls one instead of listening). Each in an empty directory.
      markup='</?tool_call>|<function=|<parameter='
      for ask in '' 'What is said in this clip?'; do
        agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
        if [ -z "$ask" ]; then
          out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work lfm3-agent --audio "$dir/test-speech.wav" 2>&1) || true
        else
          out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work lfm3-agent --no-tools --audio "$dir/test-speech.wav" "$ask" 2>&1) || true
        fi
        printf '%s\n' "> clip ${ask:-(no message)}" "$out"
        if [ -z "$out" ] || grep -Eq "$markup" <<<"$out"; then
          echo "FAIL $check: no answer, or raw tool-call markup"
          exit 1
        fi
        # lfm3-agent's example turns for Audio (AB#545) must not come back as the answer.
        if grep -Eq '^(12\.|Bonjour\.)$|cowsay' <<<"$out"; then
          echo "FAIL $check: the answer repeats an example turn"
          exit 1
        fi
        if [ -n "$ask" ] && ! grep -Eiq 'paris' <<<"$out"; then
          echo "FAIL $check: the answer does not hold \"Paris\""
          exit 1
        fi
      done
      echo "ok $check"
      ;;
    agent)
      # The answer must hold the real hostname and a run call must show on
      # stderr: the model cannot guess it, so this proves the tool loop.
      host=$(cat /proc/sys/kernel/hostname)
      agent_dir=$(mktemp -d) && mkdir "$agent_dir/work"
      out=$(LFM3_AGENT_DIR=$agent_dir LFM3_AGENT_CWD=$agent_dir/work lfm3-agent 'What is the hostname of this machine?' 2>"$agent_dir/stderr") || true
      cat "$agent_dir/stderr"
      printf '%s\n' "$out"
      if grep -q '^\$ ' "$agent_dir/stderr" && grep -qF "$host" <<<"$out"; then
        echo "ok $check"
      else
        echo "FAIL $check: no run call, or the answer does not hold the hostname $host"
        exit 1
      fi
      ;;
    *)
      echo "lfm3-selftest: unknown check $check" >&2
      exit 2
      ;;
  esac
done
