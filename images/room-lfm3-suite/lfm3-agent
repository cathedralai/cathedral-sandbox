#!/usr/bin/env bash
# lfm3-agent [options] ["message"]: talk to the model this room serves, with
# memory and tools. Each call is one turn of the same conversation, so a
# one-command-at-a-time terminal works as a chat:
#
#   lfm3-agent "What is in /work?"
#   lfm3-agent "Which of those files is the largest?"    # remembers the last turn
#   lfm3-agent --image photo.png "What is in this picture?"
#   lfm3-agent --new "Write a haiku about the sea."      # starts over
#
# With no message on a terminal (SSH or a PTY) it is an interactive chat.
#
# The model may call two tools; each call is printed on stderr as it runs:
#   run        a bash command in the sandbox ($LFM3_AGENT_CWD), with a timeout
#   read_file  the start of a text file
# --no-tools answers without them. The answer is printed on stdout.
#
# Options:
#   --new          forget the conversation first (with no message, just forget it)
#   --reset        forget the conversation and exit
#   --history      print the conversation so far and exit
#   --image FILE   add a picture to this message (VL and Omni)
#   --audio FILE   add an audio clip, WAV or MP3, to this message (Audio and Omni)
#   --system TEXT  use this system prompt from now on (default: a short one
#                  about this sandbox and the tools)
#   --no-tools     answer without running anything
#   --json         answer in JSON only, with no tools: the server holds the reply
#                  to JSON syntax (a grammar), so it parses unless it hits the
#                  token cap (LFM3_MAX_TOKENS)
#   --speak FILE   after the answer, say it: llama-server's /tts turns the
#                  answer into a WAV (PCM 16-bit, mono, 24 kHz) at FILE. Audio
#                  and Omni. If speech fails, FILE is removed, one line
#                  "<name>: no speech: <reason>" goes to stderr, and the text
#                  answer and exit code stand.
#   --warm         read the default system prompt and tools into the model
#                  server's cache and exit (lfm3-serve runs it once at boot)
#   -              read the message from stdin
#   --events       write the turn as chat events instead of plain text (AB#541,
#                  the AB#542 contract): one ASCII JSON object per line on
#                  stdout, the model streamed as it writes. Needs --turn.
#   --turn UUID    the turn id, written on every event line (with --events)
#
# Environment:
#   LFM3_AGENT_DIR            where the conversation is kept (default /tmp/lfm3/agent)
#   LFM3_AGENT_CWD            where commands run (default /work, /workspace or /tmp)
#   LFM3_AGENT_STEPS          tool rounds per message at most (default 4)
#   LFM3_AGENT_CMD_TIMEOUT    seconds per command (default 60)
#   LFM3_AGENT_OUTPUT_CHARS   tool output kept per call (default 2000)
#   LFM3_AGENT_CONTEXT_CHARS  older turns are dropped past this size (default
#                             4000). The kept conversation is read from
#                             llama-server's prompt cache (lfm3-serve runs it
#                             with --swa-full), so only new text costs time,
#                             until old turns are dropped.
#   LFM3_MAX_TOKENS           tokens per reply (default 512)
#   LFM3_SPEAK_FRAMES         most speech for --speak, in 80 ms audio frames
#                             (default 750: 60 s, which takes about 80 to 115 s
#                             to make on a sealed 2 vCPU room)
#   LFM3_AGENT_SAMPLING       sampling fields for llama-server, a JSON object
#                             (default: per model, see SAMPLING)
#   LFM3_AGENT_ANSWER_SAMPLING  sampling for a reply that is not a tool call, a
#                             JSON object, or empty to use LFM3_AGENT_SAMPLING
#                             (default: per model, see ANSWER_SAMPLING)
#   LFM3_WAIT, LFM3_TIMEOUT   as in lfm3-ask
set -euo pipefail

# --events (AB#541): chat events for the console, as the AB#542 contract
# defines them. One ASCII JSON object per line on stdout; the model is streamed
# so words arrive as they are written. Redaction happens here, before a byte
# reaches stdout, because stdout is stored and receipted. Without --events none
# of this runs and the output is the plain text it always was.
events=""
turn_id=""
ev_seq=0
ev_done=""
ev_code=""
ev_round=0
ev_calls=0
ev_used_ids=" "
prescan() { # the options that decide the mode, before any other check runs
  local a
  while [ "$#" -gt 0 ]; do
    a=$1
    case "$a" in
      --events) events=1 ;;
      --turn) turn_id=${2:-}; [ "$#" -lt 2 ] || shift ;;
      --image | --audio | --system | --speak) [ "$#" -lt 2 ] || shift ;;
      -*) ;;
      *) break ;;
    esac
    shift
  done
}
prescan "$@"
NIL_TURN=00000000-0000-0000-0000-000000000000
ev_error_text() { # code: the fixed message and whether a retry can help
  case "$1" in
    not_chat_model) ev_msg="This model does not chat."; ev_retry=false ;;
    model_unavailable) ev_msg="The model server is not ready."; ev_retry=true ;;
    model_failed) ev_msg="The model server failed."; ev_retry=true ;;
    context_too_long) ev_msg="The conversation is too long for the model."; ev_retry=false ;;
    bad_request) ev_msg="The request is not valid."; ev_retry=false ;;
    *) ev_msg="The agent failed."; ev_retry=false ;;
  esac
}
ev_emit() { # json-object-without-envelope: one line, one write, seq +1
  local obj=$1 line limit=16384
  case "$obj" in '{"type":"answer"'*) limit=262144 ;; esac
  line="{\"version\":1,\"turn_id\":\"$turn_id\",\"seq\":$((ev_seq + 1)),${obj#\{}"
  if [ "$((${#line} + 1))" -gt "$limit" ]; then
    return 1
  fi
  ev_seq=$((ev_seq + 1))
  printf '%s\n' "$line"
}
ev_error() { # code: the terminal error line; the one fatal line on stderr follows
  local code=$1
  [ -z "$ev_done" ] || return 0
  ev_done=1
  ev_error_text "$code"
  ev_emit "{\"type\":\"error\",\"code\":\"$code\",\"message\":\"$ev_msg\",\"retryable\":$ev_retry}" || true
  # Allowed by the contract: one diagnostic line, 200 bytes at most, after the error line.
  echo "${LFM3_AGENT_NAME:-lfm3-agent}: $code" >&8 2>/dev/null || true
}
ev_fail() { # code exit-status
  ev_code=$1
  exit "$2"
}
ev() { # jq options and program for one event: builds it and writes the line
  local obj
  obj=$(jq -nc -a "$@") || return 1
  ev_emit "$obj" || return 1
}
ev_clock() { # milliseconds
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local t=${EPOCHREALTIME//[^0-9]/}
    echo $((t / 1000))
  else
    echo $(($(date +%s) * 1000))
  fi
}
on_exit() {
  local rc=$?
  trap - EXIT
  if [ -n "$events" ] && [ -z "$ev_done" ]; then
    # Every turn ends with exactly one terminal line, even when the script dies.
    if [ -n "$ev_code" ]; then
      ev_error "$ev_code"
    elif [ "$rc" -eq 2 ]; then
      ev_error bad_request
    else
      ev_error internal
    fi
    [ "$rc" -ne 0 ] || rc=1
  fi
  [ -z "${work:-}" ] || rm -rf "$work"
  exit "$rc"
}
trap on_exit EXIT
if [ -n "$events" ]; then
  # Nothing but event lines on stdout and at most one fatal line on stderr: fd 8
  # keeps the real stderr for that line, every other message is dropped.
  exec 8>&2 2>/dev/null
  turn_id=${turn_id,,}
  case "$turn_id" in
    ????????-????-????-????-????????????) [[ $turn_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || turn_id="" ;;
    *) turn_id="" ;;
  esac
  if [ -z "$turn_id" ]; then
    turn_id=$NIL_TURN
    ev_fail bad_request 2
  fi
fi

usage() {
  echo 'usage: lfm3-agent [--new] [--image FILE] [--audio FILE] [--system TEXT] [--no-tools] [--json] [--speak FILE] "message"   (or "-" for stdin)' >&2
  echo '       lfm3-agent --reset | --history' >&2
  exit 2
}

if [ "${LFM3_KIND:-chat}" = decision ]; then
  [ -z "$events" ] || ev_fail not_chat_model 2
  echo "lfm3-agent: ${MODEL:-this model} is a decision model; ask it typed questions with lfm3-decide" >&2
  exit 2
fi
# A base (pretrained) model continues text: it calls no tools and makes up
# answers about the sandbox, so it gets no chat harness.
case "${MODEL:-}" in
  *-base)
    [ -z "$events" ] || ev_fail not_chat_model 2
    echo "lfm3-agent: $MODEL is a base model and cannot chat or use tools; continue text with lfm3-ask --raw \"...\"" >&2
    exit 2
    ;;
esac

BASE_URL=${MODEL_BASE_URL:-http://127.0.0.1:8080/v1}
MODEL_NAME=${MODEL:-lfm3}
MAX_TOKENS=${LFM3_MAX_TOKENS:-512}
# Sampling (ADO 523), per model, from Liquid AI's generation_config.json for
# each model we ship, with one measured exception:
#   VL and any other: temperature 0.1, top_k 50, repetition penalty 1.1 (the
#     LFM3-VL-2B and LFM3-1.7B cards).
#   Audio: greedy (its card config) plus the same frequency penalty as Omni.
#     With the card settings it stopped answering what a clip says when tools
#     were on (0 of 4). With the penalty it answered 3 of 3 (greedy alone 1 of
#     3) and hit the token cap less often on rhyme requests (14 capped requests
#     in 6 runs, greedy 20). It still adds // comments to some JSON lists
#     (ADO 547), so JSON from Audio needs --json.
#   Omni: greedy (its card config) plus a frequency penalty of 0.3, which grows
#     with each repeat of a token in the last 64. Greedy alone looped on rhyme
#     requests until the 512-token cap (prod, 4 Nov; 4 of 30 rhyme prompts
#     locally, 1 of 30 with the penalty). Sampling at temperature 0.1 stopped
#     the loops too, but made the tool choice vary: Omni ran "hostname -I" for
#     the hostname in 4 of 8 runs and made the answer up. Greedy ran hostname 8
#     of 8. llama.cpp's DRY sampler with the repetition penalty broke verbatim
#     copies (a hostname came back with its last character changed), so it is
#     not used. A JSON array of 30 objects and a 31-line script came out
#     identical with and without the penalty.
case "${MODEL:-}" in
  *omni* | *audio*) default_sampling='{"temperature": 0, "frequency_penalty": 0.3}' ;;
  *) default_sampling='{"temperature": 0.1, "top_k": 50, "repeat_penalty": 1.1}' ;;
esac
SAMPLING=${LFM3_AGENT_SAMPLING:-$default_sampling}
# Omni's answers (ADO 550). Greedy decoding picks tools reliably (above), but it
# also gives every room the same words: ten new rooms asked for a rap wrote one
# rap ten times. So when tools are on, a round first reads two greedy tokens: a
# tool call ("<tool_call>") runs greedily as before, and an answer is written
# with this sampling, so each room writes its own. A picture or clip in the
# conversation and --json stay greedy. top_k must be set: Omni's GGUF makes
# llama-server default to top_k 1, which is greedy at any temperature.
# Measured in a sealed room (4 Nov 2026, 5 runs each, random seeds): at
# temperature 0.5, top_k 40, min_p 0.05 a four line rap and three rhyme prompts
# came out 5 of 5 different with no loop, while "17 times 23" (391) and "the
# capital of Australia" (Canberra) came out the same and right 5 of 5. At 0.7
# one rhyme answer started repeating; at 1.5 the text broke down.
case "${MODEL:-}" in
  *omni*) default_answer='{"temperature": 0.5, "top_k": 40, "min_p": 0.05, "frequency_penalty": 0.3}' ;;
  *) default_answer="" ;;
esac
# A sampling set by hand (LFM3_AGENT_SAMPLING) applies to answers too, unless
# LFM3_AGENT_ANSWER_SAMPLING is also set.
[ -z "${LFM3_AGENT_SAMPLING:-}" ] || default_answer=""
ANSWER_SAMPLING=${LFM3_AGENT_ANSWER_SAMPLING-$default_answer}
# --json: llama-server turns a schema into a grammar and samples only tokens
# that keep the reply valid JSON. An empty schema would mean an object only, so
# the schema allows an array too. The grammar fixes the syntax, not the count
# asked for, so a --json request also carries JSON_LINE in its system prompt.
# Measured on Audio, the pinned GGUF on b11960 (ADO 547), the selftest's
# 15-object request from 12 sandbox paths: 10 of 12 parsed as 15 objects with
# the grammar alone (where Audio wanted a // comment it wrote a number and
# closed the list), 12 of 12 with the line too. The line alone: 5 of 6.
JSON_FORMAT='{"type": "json_schema", "json_schema": {"name": "answer", "schema": {"type": ["object", "array"]}}}'
# The last round of a turn that ran tools offers no tools. Without a word, Omni
# often answered it with nothing after four rounds of looking for a speech tool
# (ADO 551), so that request ends with this line. It is not kept in the
# conversation.
FINAL_LINE='Now answer my message in text, without tools.'
JSON_LINE='When you are asked for JSON, output valid JSON only, no comments.'
STEPS=${LFM3_AGENT_STEPS:-4}
CMD_TIMEOUT=${LFM3_AGENT_CMD_TIMEOUT:-60}
OUTPUT_CHARS=${LFM3_AGENT_OUTPUT_CHARS:-2000}
CONTEXT_CHARS=${LFM3_AGENT_CONTEXT_CHARS:-4000}
LOG=${LFM3_LOG_DIR:-/tmp/lfm3}/server.log
if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$SAMPLING"; then
  echo "lfm3-agent: LFM3_AGENT_SAMPLING must be a JSON object" >&2
  exit 2
fi
if [ -n "$ANSWER_SAMPLING" ] && ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$ANSWER_SAMPLING"; then
  echo "lfm3-agent: LFM3_AGENT_ANSWER_SAMPLING must be a JSON object or empty" >&2
  exit 2
fi
DIR=${LFM3_AGENT_DIR:-/tmp/lfm3/agent}
# lfm3-serve makes /tmp/lfm3 as the image user; an exec as another user keeps
# its conversation beside it instead.
if ! mkdir -p "$DIR" 2>/dev/null || [ ! -w "$DIR" ]; then
  if [ -n "${LFM3_AGENT_DIR:-}" ]; then
    echo "lfm3-agent: cannot write $DIR" >&2
    exit 1
  fi
  DIR=/tmp/lfm3-agent-$(id -u)
  mkdir -p "$DIR"
fi
HISTORY=$DIR/history.json
SYSTEM_FILE=$DIR/system.txt
# The last picture or clip, sent again with later turns so follow-up questions
# about it see it. Older media stay in the history as a note only.
MEDIA_FILE=$DIR/media.json

if [ -n "${LFM3_AGENT_CWD:-}" ]; then
  CWD=$LFM3_AGENT_CWD
elif [ -d /work ]; then
  CWD=/work
elif [ -d /workspace ]; then
  CWD=/workspace
else
  CWD=/tmp
fi

default_system() {
  cat <<PROMPT
You are $MODEL_NAME, a small assistant inside a Cathedral sandbox: a sealed Linux container on an AMD SEV-SNP host. Answer briefly and directly.
Tools: run executes a bash command here (working directory $CWD) and returns its exit code and output. read_file returns the start of a text file.
Use a tool for questions about this machine: its files, programs, memory, disk, CPUs, processes or network, or to run code. Answer everything else yourself, without a tool: facts, math, writing, translation.
The network may be off. Never say you ran a command unless you called run and saw the result.
PROMPT
}

TOOLS='[
  {"type": "function", "function": {"name": "run",
    "description": "Run a bash command in this sandbox. Returns the exit code and the output.",
    "parameters": {"type": "object", "properties": {"command": {"type": "string", "description": "The bash command line"}}, "required": ["command"]}}},
  {"type": "function", "function": {"name": "read_file",
    "description": "Read the start of a text file in this sandbox.",
    "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}}, "required": ["path"]}}}
]'

chmod 700 "$DIR"
work=$(mktemp -d)

# One conversation, one writer: two calls at once would interleave turns.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$DIR/lock"
  flock -w 600 9 || { echo "lfm3-agent: another lfm3-agent is still answering" >&2; exit 1; }
fi

forget() { rm -f "$HISTORY" "$SYSTEM_FILE" "$MEDIA_FILE"; }

show_history() {
  [ -s "$HISTORY" ] || { echo "(no conversation yet)"; return; }
  jq -r '.[] |
    if .role == "user" then "you: " + (.content | tostring)
    elif .role == "assistant" and ((.tool_calls // []) | length) > 0 then
      (.tool_calls[] | "  [" + .function.name + "] " + (.function.arguments | tostring))
    elif .role == "assistant" then "model: " + (.content // "")
    elif .role == "tool" then "  -> " + ((.content // "") | split("\n") | first)
    else empty end' "$HISTORY"
}

echo '[]' >"$work/parts"
echo '[]' >"$work/names"
echo '[]' >"$work/no_media"
system=""
prompt=""
tools=1
json=""
fresh=""
warm=""
speak_file=""

add_part() { # kind file
  [ -r "$2" ] || { echo "lfm3-agent: cannot read $2" >&2; exit 2; }
  base64 <"$2" | tr -d '\n' >"$work/b64"
  case "$1" in
    image)
      case "${2,,}" in
        *.jpg | *.jpeg) mime=image/jpeg ;;
        *.webp) mime=image/webp ;;
        *.gif) mime=image/gif ;;
        *) mime=image/png ;;
      esac
      jq --rawfile d "$work/b64" --arg m "$mime" \
        '. + [{type: "image_url", image_url: {url: ("data:" + $m + ";base64," + $d)}}]' \
        "$work/parts" >"$work/parts.new"
      ;;
    audio)
      case "${2,,}" in
        *.mp3) format=mp3 ;;
        *) format=wav ;;
      esac
      jq --rawfile d "$work/b64" --arg f "$format" \
        '. + [{type: "input_audio", input_audio: {data: $d, format: $f}}]' \
        "$work/parts" >"$work/parts.new"
      ;;
  esac
  mv "$work/parts.new" "$work/parts"
  # The conversation keeps a note of the file, not its bytes.
  jq --arg n "$1: ${2##*/}" '. + [$n]' "$work/names" >"$work/names.new"
  mv "$work/names.new" "$work/names"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help) usage ;;
    --events)
      shift
      ;;
    --turn)
      [ "$#" -ge 2 ] || usage
      shift 2
      ;;
    --reset)
      [ -z "$events" ] || usage
      forget
      echo "lfm3-agent: conversation cleared" >&2
      exit 0
      ;;
    --history)
      [ -z "$events" ] || usage
      show_history
      exit 0
      ;;
    --new)
      fresh=1
      shift
      ;;
    --warm)
      warm=1
      shift
      ;;
    --speak)
      [ "$#" -ge 2 ] || usage
      speak_file=$2
      shift 2
      ;;
    --no-tools)
      tools=""
      shift
      ;;
    --json)
      json=1
      tools=""
      shift
      ;;
    --image | --audio)
      [ "$#" -ge 2 ] || usage
      add_part "${1#--}" "$2"
      shift 2
      ;;
    --system)
      [ "$#" -ge 2 ] || usage
      system=$2
      shift 2
      ;;
    -)
      prompt=$(cat)
      shift
      ;;
    -*) usage ;;
    *)
      prompt="$*"
      break
      ;;
  esac
done

# Voice and JSON turns stay on the plain path in v1 (AB#542 section 9), and an
# events turn is never interactive.
[ -n "$events" ] || [ -z "$turn_id" ] || usage
if [ -n "$events" ]; then
  if [ -n "$json" ] || [ -n "$speak_file" ] || [ -n "$warm" ]; then usage; fi
  if [ -z "$prompt" ] && [ "$(jq length "$work/parts")" -eq 0 ]; then usage; fi
fi

# --warm (lfm3-serve, once at boot) leaves the kept conversation alone.
if [ -z "$warm" ]; then
  [ -z "$fresh" ] || forget
  [ -s "$HISTORY" ] || echo '[]' >"$HISTORY"
  if [ -n "$system" ]; then
    printf '%s' "$system" >"$SYSTEM_FILE"
  elif [ ! -s "$SYSTEM_FILE" ]; then
    default_system >"$SYSTEM_FILE"
  fi
fi

wait_for_server() {
  for _ in $(seq 1 "${LFM3_WAIT:-120}"); do
    if curl -fsS -o /dev/null "${BASE_URL%/v1}/health" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  echo "lfm3-agent: the model server at $BASE_URL is not up (log: $LOG)" >&2
  exit 1
}

with_timeout() {
  if command -v timeout >/dev/null 2>&1; then
    timeout -k 5 "$CMD_TIMEOUT" "$@"
  else
    "$@"
  fi
}

clip() { # file: the first OUTPUT_CHARS characters, and how much was cut
  local size
  size=$(wc -c <"$1" | tr -d ' ')
  head -c "$OUTPUT_CHARS" "$1"
  if [ "$size" -gt "$OUTPUT_CHARS" ]; then
    printf '\n[... %s more bytes not shown]' "$((size - OUTPUT_CHARS))"
  fi
}

# What a tool call did, for the tool_result event (--events): status, exit code
# or null, output bytes before clipping, and whether the model got a clipped copy.
tool_meta() { # status exit-code output-bytes
  [ -n "$events" ] || return 0
  local cut=false
  [ "$3" -le "$OUTPUT_CHARS" ] || cut=true
  printf '%s %s %s %s\n' "$1" "$2" "$3" "$cut" >"$work/tool_meta"
}

run_tool() { # name arguments-json: prints the result the model reads
  local name=$1 args=$2 value status size
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$args"; then
    tool_meta refused null 0
    echo "error: the arguments are not a JSON object: $args"
    return
  fi
  case "$name" in
    run)
      value=$(jq -r '.command // empty | tostring' <<<"$args")
      [ -n "$value" ] || { tool_meta refused null 0; echo "error: run needs a command"; return; }
      printf '$ %s\n' "$value" >&2
      status=0
      (cd "$CWD" && with_timeout bash -c "$value") </dev/null >"$work/tool_out" 2>&1 8>&- || status=$?
      size=$(wc -c <"$work/tool_out" | tr -d ' ')
      if [ "$status" -eq 124 ]; then
        tool_meta timeout 124 "$size"
        printf 'exit code: 124 (stopped after %ss)\n' "$CMD_TIMEOUT"
      else
        if [ "$status" -eq 0 ]; then tool_meta ok 0 "$size"; else tool_meta error "$status" "$size"; fi
        printf 'exit code: %s\n' "$status"
      fi
      clip "$work/tool_out"
      ;;
    read_file)
      value=$(jq -r '.path // empty | tostring' <<<"$args")
      [ -n "$value" ] || { tool_meta refused null 0; echo "error: read_file needs a path"; return; }
      case "$value" in /*) ;; *) value=$CWD/$value ;; esac
      printf '[read_file] %s\n' "$value" >&2
      if [ -f "$value" ] && [ -r "$value" ]; then
        tool_meta ok null "$(wc -c <"$value" | tr -d ' ')"
        clip "$value"
      else
        tool_meta error null 0
        echo "error: cannot read $value"
      fi
      ;;
    *)
      tool_meta refused null 0
      echo "error: there is no tool named $name; use run or read_file"
      ;;
  esac
}

# The messages for one request: the system prompt, as many earlier turns as
# fit CONTEXT_CHARS (whole turns, oldest dropped first), this message with its
# media, and the tool calls of this turn so far. Without new media, the last
# picture or clip goes back on the message that brought it, if that is kept.
build_body() { # with-tools [max-tokens] [sampling]
  local n=${2:-$MAX_TOKENS} sampling=${3:-$SAMPLING}
  local media=$MEDIA_FILE
  [ -s "$media" ] || media=$work/no_media
  jq -n --rawfile sys "$SYSTEM_FILE" --slurpfile hist "$HISTORY" \
    --slurpfile stored "$work/user_stored" --slurpfile sent "$work/user_sent" \
    --slurpfile turn "$work/turn" --slurpfile media "$media" --slurpfile parts "$work/parts" \
    --argjson room "$CONTEXT_CHARS" --arg model "$MODEL_NAME" --argjson n "$n" \
    --argjson tools "$TOOLS" --arg with_tools "$1" --argjson sampling "$sampling" \
    --arg json "$json" --argjson format "$JSON_FORMAT" --arg json_line "$JSON_LINE" --arg final_line "$FINAL_LINE" '
    def drop_turn: (.[1:] | map(.role == "user") | index(true)) as $i
      | if $i == null then [] else .[($i + 1):] end;
    def fit($room): if length == 0 or (tojson | length) <= $room then . else (drop_turn | fit($room)) end;
    def attach($m): ([to_entries[] | select(.value.role == "user" and .value.media == true) | .key] | last) as $i
      | if ($m | length) == 0 or $i == null then .
        else .[$i].content = ($m + [{type: "text", text: (.[$i].content | tostring)}]) end;
    ([{role: "system", content: $sys}] + $stored[0] + $turn[0] | tojson | length) as $fixed
    | ($hist[0] | fit($room - $fixed)
       | if ($parts[0] | length) == 0 then attach($media[0]) else . end
       | map(del(.media))) as $kept
    | {
        model: $model,
        messages: ([{role: "system", content: ($sys + (if $json == "1" then "\n" + $json_line else "" end))}] + $kept + ($sent[0] | map(del(.media))) + $turn[0]
          + (if $with_tools != "1" and ($turn[0] | length) > 0 then [{role: "user", content: $final_line}] else [] end)),
        max_tokens: $n
      }
    + $sampling
    + (if $with_tools == "1" then {tools: $tools} else {} end)
    + (if $json == "1" then {response_format: $format} else {} end)' >"$work/body"
}

normalize_reply() { # $work/out holds a chat completion: the reply message goes to $work/msg
  # A tool call the server did not parse stays in the text as markup. Parse it
  # the way Liquid's model card does (<tool_call><function=NAME><parameter=KEY>
  # VALUE</parameter></function></tool_call>, or a JSON body), and never show
  # raw markup: what cannot be parsed becomes one clean line.
  jq '
    def strip: sub("^\\s+"; "") | sub("\\s+$"; "");
    def value: . as $s | try ($s | fromjson) catch $s;
    def xml_calls: [scan("<tool_call>\\s*<function=([^>\\n]+)>([\\s\\S]*?)</function>\\s*</tool_call>")]
      | map(. as [$name, $body] | {name: ($name | strip),
          arguments: ([$body | scan("<parameter=([^>\\n]+)>\\n?([\\s\\S]*?)\\n?</parameter>")]
            | map(. as [$k, $v] | {key: ($k | strip), value: ($v | value)}) | from_entries)});
    def json_calls: [scan("<tool_call>\\s*(\\{[\\s\\S]*?\\})\\s*</tool_call>")]
      | map(.[0] | try fromjson catch null | select(type == "object" and (.name | type) == "string")
        | {name, arguments: (.arguments // .parameters // {})});
    .choices[0].message
    | if ((.tool_calls // []) | length) == 0 and ((.content // "") | test("</?tool_call>|<function=")) then
        (.content | xml_calls + json_calls) as $calls
        | (.content | gsub("<tool_call>[\\s\\S]*?</tool_call>"; "") | gsub("<tool_call>[\\s\\S]*$"; "")
           | gsub("</?(tool_call|function|parameter)[^>]*>"; "") | strip) as $rest
        | if ($calls | length) > 0 then
            .content = $rest
            | .tool_calls = [$calls | to_entries[]
                | {id: ("call_text_" + (.key | tostring)), type: "function",
                   function: {name: .value.name, arguments: (.value.arguments | tojson)}}]
          elif $rest == "" then .content = "(The model tried to call a tool, but the call could not be read.)"
          else .content = $rest end
      else . end' "$work/out" >"$work/msg"
}

ask_model() { # with-tools [sampling]: the reply message goes to $work/msg
  local status=0 code
  build_body "$1" "" "${2:-}"
  curl -sS --max-time "${LFM3_TIMEOUT:-600}" -o "$work/out" -w '%{http_code}' \
    -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
    --data-binary @"$work/body" "$BASE_URL/chat/completions" >"$work/code" || status=$?
  code=$(cat "$work/code" 2>/dev/null || true)
  # A tool call whose arguments ran past the token cap (a looping heredoc, ADO
  # 551) comes back as a 500. The caller answers without tools instead.
  if [ "$1" = 1 ] && [ "$code" = 500 ] && grep -q 'parse tool call' "$work/out" 2>/dev/null; then
    return 3
  fi
  if [ "$status" -ne 0 ] || [ "$code" != 200 ]; then
    head -c 2000 "$work/out" >&2 2>/dev/null || true
    echo >&2
    echo "lfm3-agent: $BASE_URL/chat/completions answered ${code:-nothing} (curl exit $status)" >&2
    if grep -qi 'context' "$work/out" 2>/dev/null; then
      echo "lfm3-agent: the conversation is too long for the model; start over with --new" >&2
    fi
    exit 1
  fi
  normalize_reply
}


slot_call() { # save | restore: the server's slot 0 and $LFM3_SLOT_DIR/warm.bin; prints the HTTP status
  curl -sS --max-time 60 -o /dev/null -w '%{http_code}' -X POST \
    -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
    -d '{"filename": "warm.bin"}' "${BASE_URL%/v1}/slots/0?action=$1" 2>/dev/null || true
}

# --warm: read the default system prompt and the tool list into the server's
# cache. The next message shares that prefix, so only its own words are read.
# lfm3-prewarm (image build, LFM3_WARM_SAVE=1) saves the state with the
# request's sha256; at boot the same request restores it in about 15 ms
# instead of reading the prompt (about 4.7 s in a sealed 2 vCPU room, 5 Nov
# 2026). A different request (another system prompt, model or sampling) reads.
warm_cache() {
  local slot_dir=${LFM3_SLOT_DIR:-/opt/lfm3/cache} sum code
  SYSTEM_FILE=$work/system HISTORY=$work/history MEDIA_FILE=$work/no_media
  default_system >"$SYSTEM_FILE"
  echo '[]' >"$HISTORY"
  echo '[{"role": "user", "content": "hi"}]' >"$work/user_stored"
  cp "$work/user_stored" "$work/user_sent"
  echo '[]' >"$work/turn"
  wait_for_server
  build_body 1 1
  sum=$(sha256sum "$work/body" | cut -d' ' -f1)
  if [ -z "${LFM3_WARM_SAVE:-}" ] && [ -s "$slot_dir/warm.bin" ] && [ "$(cat "$slot_dir/warm.sha256" 2>/dev/null)" = "$sum" ]; then
    code=$(slot_call restore)
    if [ "$code" = 200 ]; then
      echo "lfm3-agent --warm: restored"
      return
    fi
    echo "lfm3-agent --warm: restore answered $code; reading the prompt"
  fi
  echo "lfm3-agent --warm: HTTP $(curl -sS --max-time "${LFM3_TIMEOUT:-600}" -o /dev/null -w '%{http_code}' \
    -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
    --data-binary @"$work/body" "$BASE_URL/chat/completions" || true)"
  if [ -n "${LFM3_WARM_SAVE:-}" ]; then
    code=$(slot_call save)
    if [ "$code" != 200 ]; then
      echo "lfm3-agent --warm: save answered $code" >&2
      exit 1
    fi
    echo "$sum" >"$slot_dir/warm.sha256"
    echo "lfm3-agent --warm: saved"
  fi
}

# Does this round start with a tool call? Two greedy tokens tell: Omni starts
# a call with "<tool_call>". Unclear, empty or failed counts as a call, so the
# round runs greedily as it did before ANSWER_SAMPLING.
starts_tool_call() {
  local code
  build_body 1 2
  code=$(curl -sS --max-time "${LFM3_TIMEOUT:-600}" -o "$work/probe" -w '%{http_code}' \
    -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
    --data-binary @"$work/body" "$BASE_URL/chat/completions" 2>/dev/null) || return 0
  [ "$code" = 200 ] || return 0
  [ "$(jq -r '.choices[0].message
    | if ((.tool_calls // []) | length) > 0
         or ((.content // "") | test("^\\s*$|<tool_call|<function=|<\\|tool"))
      then "tool" else "answer" end' "$work/probe" 2>/dev/null)" != answer ]
}

# The sampling for this round: ANSWER_SAMPLING for an answer, SAMPLING for a
# tool call, a picture or clip in the conversation, or --json.
round_sampling() { # with-tools
  if [ -z "$ANSWER_SAMPLING" ] || [ -n "$json" ] || [ "$(jq length "$work/parts")" -gt 0 ] || [ -s "$MEDIA_FILE" ]; then
    echo "$SAMPLING"
  elif [ "$1" = 1 ] && starts_tool_call; then
    echo "$SAMPLING"
  else
    echo "$ANSWER_SAMPLING"
  fi
}

# The answer, cut where it starts to repeat. A loop is one unit repeated many
# times that fills much of the answer: a clause (text between newlines and
# . , ; ! ?) seen 6 times, or a 4-word run seen 10 times, covering at least 40%
# of it. A short refrain does not count. Keep the text up to the unit's second
# copy and say so in one line. jq 1.6 indexes strings by byte, so the cut is
# found with split, which counts characters.
loop_guard() { # answer-file: rewrites it; prints "looped" when it cut
  jq -rn --rawfile t "$1" '
    def strip: sub("^\\s+"; "") | sub("\\s+$"; "");
    ($t | ascii_downcase) as $low
    | ([$low | splits("[\\n.,;!?]+") | gsub("[*_#>`\"]"; "") | strip | select(length >= 3)]
       | group_by(.) | map({u: .[0], n: length}) | max_by(.n * (.u | length)) // {u: "", n: 0}) as $c
    | ([$low | scan("[a-z0-9\u0027]+")]) as $w
    | ([range(0; ($w | length) - 3) as $i | $w[$i:$i + 4] | join(" ")]
       | group_by(.) | map({u: .[0], n: length}) | max_by(.n) // {u: "", n: 0}) as $g
    | (($c.n >= 6 and $c.n * ($c.u | length) * 10 >= ($t | length) * 4)
       or ($g.n >= 10 and $g.n * 40 >= ($w | length) * 10)) as $loop
    | if $loop then
        ($low | split($c.u)) as $parts
        | (if $c.n >= 3 and ($parts | length) >= 3
           then $t[0:(($parts[0] | length) + ($c.u | length) + ($parts[1] | length))]
           else $t[0:300] end | strip | sub("[\\s,;:]+$"; "")) as $kept
        | "looped", $kept
      else "ok", $t end' >"$1.guard"
  if [ "$(head -n 1 "$1.guard")" = looped ]; then
    sed '1d' "$1.guard" >"$1"
    echo looped
  fi
  rm -f "$1.guard"
}

# --speak: the answer as speech. Markdown marks are taken out first: the model
# reads a "## " heading as made-up words, while * and ` are silent. Each line
# becomes a phrase. Then each sentence is one /tts request, and the pieces are
# joined into one WAV. Spoken in one request, a long answer turns to babble:
# Omni's 138-word rap came back 71% heard and capped at 60 s, against 98% heard
# and 51 s one sentence at a time (also faster to make), and Audio repeated its
# last phrase (5 Nov 2026, ASR in 10 s slices). Each request costs about 0.4 s
# more. The frame cap counts the whole answer. FILE holds this answer's speech
# or nothing; it is written whole (a temporary file, then a rename) with real
# RIFF and data sizes, so a reader never gets half a WAV.
SPEAK_FRAMES=${LFM3_SPEAK_FRAMES:-750}
le32() { # n: four bytes, little-endian
  printf "\\x$(printf %02x $(($1 & 255)))\\x$(printf %02x $((($1 >> 8) & 255)))\\x$(printf %02x $((($1 >> 16) & 255)))\\x$(printf %02x $((($1 >> 24) & 255)))"
}
speak_one() { # text-file frames: one /tts request into $work/speech; prints the reason it failed
  local status=0 code msg
  jq -n --rawfile t "$1" --argjson n "$2" '{input: ($t | rtrimstr("\n")), n_predict: $n}' >"$work/tts_body" 2>/dev/null || true
  curl -sS --max-time "${LFM3_TIMEOUT:-600}" -o "$work/speech" -w '%{http_code}' \
    -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
    --data-binary @"$work/tts_body" "${BASE_URL%/v1}/tts" >"$work/tts_code" 2>/dev/null || status=$?
  code=$(cat "$work/tts_code" 2>/dev/null || true)
  if [ "$status" -ne 0 ]; then
    echo "the model server did not answer (curl exit $status)"
  elif [ "$code" != 200 ]; then
    msg=$(jq -r '.error.message // empty' "$work/speech" 2>/dev/null) || msg=$(head -c 200 "$work/speech" 2>/dev/null | tr -d '\n') || msg=""
    echo "the model server answered ${code:-nothing}${msg:+: ${msg:0:200}}"
  elif [ "$(head -c 4 "$work/speech")" != RIFF ] || [ "$(dd if="$work/speech" bs=1 skip=36 count=4 2>/dev/null)" != data ] \
    || [ "$(wc -c <"$work/speech")" -le 44 ]; then
    echo "the model server did not send a WAV"
  fi
  return 0
}
speak_answer() { # answer-file out-file
  local out=$2 tmp reason="" n=0 i=0 left size rate used=0 data=0 frame_bytes=3840
  rm -f "$out" 2>/dev/null || true
  : >"$work/speech_data"
  jq -n --rawfile t "$1" '
    def speakable:
      split("\n")
      | map(gsub("```[A-Za-z0-9_-]*"; "") | gsub("[*`#>|~]+"; "") | gsub("_+"; " ")
            | sub("^\\s+"; "") | sub("^[-+]\\s+"; "") | sub("\\s+$"; "")
            | select(length > 0)
            | if test("[.!?:;,]$") then . else . + "." end)
      | join(" ");
    [$t | speakable | splits("(?<=[.!?:;])\\s+") | select(length > 0)]' >"$work/sentences" 2>/dev/null \
    || reason="cannot read the answer"
  if [ -z "$reason" ]; then
    n=$(jq length "$work/sentences")
    [ "$n" -gt 0 ] || reason="the answer has no words to say"
  fi
  while [ -z "$reason" ] && [ "$i" -lt "$n" ]; do
    left=$((SPEAK_FRAMES - used))
    [ "$left" -gt 0 ] || break
    jq -r --argjson i "$i" '.[$i]' "$work/sentences" >"$work/sentence"
    reason=$(speak_one "$work/sentence" "$left")
    [ -z "$reason" ] || break
    if [ "$i" -eq 0 ]; then
      # WAVE, the fmt chunk and the data tag (bytes 8 to 39) from the first
      # piece; an 80 ms frame is 8% of the byte rate.
      head -c 40 "$work/speech" | tail -c 32 >"$work/wav_fmt"
      rate=$(od -An -tu4 -j28 -N4 "$work/speech" 2>/dev/null | tr -d ' ') || rate=""
      case "$rate" in '' | *[!0-9]*) rate=48000 ;; esac
      frame_bytes=$((rate * 8 / 100))
      [ "$frame_bytes" -gt 0 ] || frame_bytes=3840
    fi
    size=$(( $(wc -c <"$work/speech") - 44 ))
    tail -c +45 "$work/speech" >>"$work/speech_data"
    data=$((data + size))
    used=$((used + (size + frame_bytes - 1) / frame_bytes))
    i=$((i + 1))
  done
  if [ -z "$reason" ]; then
    tmp=$out.partial.$$
    if ! { { printf RIFF; le32 $((36 + data)); cat "$work/wav_fmt"; le32 "$data"; cat "$work/speech_data"; } >"$tmp" \
      && mv -f "$tmp" "$out"; } 2>/dev/null; then
      rm -f "$tmp" 2>/dev/null || true
      reason="cannot write $out"
    fi
  fi
  if [ -n "$reason" ]; then
    echo "${LFM3_AGENT_NAME:-lfm3-agent}: no speech: $reason" >&2
  fi
  return 0
}

# --events: the model's reply, streamed. llama-server answers with SSE
# (stream: true). One jq reads the stream as it arrives and writes a delta line
# per piece of answer text. It holds text back from a "<" until the next
# characters rule out the start of tool-call markup or reasoning (AB#542
# section 5.6), so none of that is ever a delta; the tool call itself and the
# full text are collected and handled like a non-streaming reply. Streamed
# tool-call fragments and reasoning_content are never forwarded.
# Values removed by value (AB#541). A value whose variable is named like a
# credential goes at any length (a short key is still a key); any other value
# goes from 8 characters up. Longest first so a value that contains another is
# removed whole. Stream hold uses hold_secrets (credentials + non-infra env
# values of length >= 8) so a FOO=... style secret cannot leak as deltas, while
# PATH/HOME/MODEL/LFM3_* do not reshape every host's stream.
read -r -d '' SECRETS_JQ <<'JQ' || true
def credentials:
  [$ENV | to_entries[]
   | select(.value | type == "string" and length > 0)
   | select(.key | test("key|token|secret|passw|pass|auth|cred|private|cookie|session"; "i"))
   | .value] | unique;
def secrets:
  ([$ENV[] | select(type == "string" and length >= 8)] + credentials) | unique | sort_by(length) | reverse;
# Infra keys are always present in the room; holding their prefixes would make
# delta boundaries depend on PATH/MODEL and break the chat-events contract.
# Credential-named keys (including MODEL_API_KEY) stay in hold via credentials.
def infra_key: test("^(PATH|HOME|PWD|USER|LOGNAME|SHELL|TERM|LANG|LC_|TMPDIR|TMP|TEMP|SHLVL|_|HOSTNAME|OLDPWD|MODEL|MODEL_|LFM3_)");
def hold_secrets:
  (credentials
   + [$ENV | to_entries[]
      | select(.value | type == "string" and length >= 8)
      | select(.key | infra_key | not)
      | .value]) | unique | sort_by(length) | reverse;
def redact($S): reduce $S[] as $v (.; split($v) | join("[redacted]"));
JQ

read -r -d '' STREAM_JQ <<'JQ' || true
def toks: ["<tool_call", "</tool_call", "<function=", "<parameter=", "<|", "<think"];
def chunks: if length == 0 then empty else .[0:1024], (.[1024:] | chunks) end;
def drain:
  if .mode == "drop" then .buf = ""
  elif .mode == "think" then
    (.buf | split("</think>")) as $p
    | if ($p | length) > 1 then .buf = ($p[1:] | join("</think>")) | .mode = "text" | drain
      else .buf = (if (.buf | length) > 8 then .buf[(.buf | length) - 8:] else .buf end) end
  else
    (.buf | split("<")[0]) as $h
    | .out += $h
    | .buf = .buf[($h | length):]
    | if .buf == "" then .
      else
        .buf as $r
        | ([toks[] | . as $t | select($r | startswith($t))] | first // null) as $m
        | if $m != null then
            (if $m == "<think" then .mode = "think" | .buf = $r[6:] else .mode = "drop" | .buf = "" end) | drain
          elif any(toks[]; startswith($r)) then .
          else .out += "<" | .buf = $r[1:] | drain end
      end
  end;
def parse:
  if startswith("data:") then
    (ltrimstr("data:") | sub("^ "; "")) as $d
    | ($d | sub("\\s+$"; "")) as $d
    | if $d == "[DONE]" then {done: true}
      else ((try ($d | fromjson) catch {skip: true}) | if type == "object" then . else {skip: true} end) end
  else {skip: true} end;
# Text is held back while its tail could be the start of a hold_secrets value,
# so a user/credential secret split across stream pieces never reaches a delta.
def tail_len($C): . as $r
  | ([$C[] | length] | max // 0) as $m
  | ([range(1; ([$m, ($r | length) + 1] | min)) as $k
      | select(any($C[]; length > $k and startswith($r[($r | length) - $k:]))) | $k] | max) // 0;
def hold($t; $S):
  ((.sbuf + $t) | redact($S)) as $r
  | ($r | tail_len(hold_secrets)) as $n
  | .sbuf = $r[($r | length) - $n:]
  | .buf += $r[0:($r | length) - $n]
  | drain;
def finish($S):
  .buf += (.sbuf | redact($S)) | .sbuf = ""
  | drain
  | if .mode == "text" then .out += .buf | .buf = "" else . end
  | if .out != "" then .emit = [.out | chunks] | .out = "" else . end;
def apply($c; $S):
  if $c.done then .done = true
  elif $c.error != null then .err = true
  else
    (($c.choices // [])[0] // {}) as $ch
    | ($ch.delta // {}) as $d
    | (if ($d.content | type) == "string" then $d.content else "" end) as $t
    | reduce (($d.tool_calls // [])[]) as $tc (.;
        ($tc.index // 0 | tostring) as $k
        | .calls[$k].id = ($tc.id // .calls[$k].id // null)
        | .calls[$k].name = ($tc.function.name // .calls[$k].name // null)
        | .calls[$k].args = ((.calls[$k].args // "") + (($tc.function.arguments // "") | if type == "string" then . else tojson end)))
    | if $ch.finish_reason != null then .finish = $ch.finish_reason else . end
    | if $t != "" then .text += $t | hold($t; $S) else . end
    | if .out != "" then .emit = [.out | chunks] | .out = "" else . end
  end;
secrets as $S
| foreach ((inputs | {line: rtrimstr("\r")}), {end: true}) as $x (
  {buf: "", sbuf: "", out: "", mode: "text", text: "", calls: {}, finish: null, done: false, err: false, emit: [], final: false};
  .emit = [] | if $x.end then .final = true | finish($S) else apply($x.line | parse; $S) end;
  (.emit[] | {type: "delta", round: $round, text: .}),
  (select(.final) | {_end: {
    content: .text, finish: .finish, err: .err, done: (.done or .finish != null),
    tool_calls: (.calls | to_entries | sort_by(.key | tonumber)
      | map({id: (.value.id // ("call_s" + .key)), type: "function",
             function: {name: (.value.name // ""), arguments: (.value.args // "")}})) }}))
JQ

# What a tool call may show on the Chat surface (AB#542 section 6): a one-line
# summary with secrets removed. Applied here, before stdout.
read -r -d '' SUMMARY_JQ <<'JQ' || true
def u16: explode | map(if . >= 65536 then 2 else 1 end) | add // 0;
def one_line: explode | reduce .[] as $c ({o: [], p: false};
    if $c < 32 or ($c >= 127 and $c <= 159) then (if .p then . else .o += [32] | .p = true end)
    else .o += [$c] | .p = false end) | .o | implode;
def names: "key|token|secret|passw|pass|auth|cred|private|cookie|session";
def scrub:
  . as $in
  | gsub("-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)"; "[redacted]")
  | redact(secrets)
  | gsub("(?<n>authorization\\s*[:=]\\s*)(?:(?:bearer|basic|token)\\s+)?[^\\s'\"]+"; "\(.n)[redacted]"; "i")
  | gsub("(?<n>[A-Za-z0-9_.-]*(?:" + names + ")[A-Za-z0-9_.-]*[\"']?\\s*:\\s*)(?:(?:bearer|basic|token)\\s+)?(?:\"[^\"]*\"|'[^']*'|[^\\s'\"]+)"; "\(.n)[redacted]"; "i")
  | gsub("(?<n>\\bbearer\\s+)[^\\s'\"]+"; "\(.n)[redacted]"; "i")
  | gsub("(?<n>[A-Za-z0-9_.-]*(?:" + names + ")[A-Za-z0-9_.-]*)=(?:\"[^\"]*\"|'[^']*'|[^\\s'\"]+)"; "\(.n)=[redacted]"; "i")
  | gsub("(?<n>--[A-Za-z0-9_-]*(?:" + names + ")[A-Za-z0-9_-]*)(?<s>=|\\s+)(?!-)(?:\"[^\"]*\"|'[^']*'|[^\\s'\"]+)"; "\(.n)\(.s)[redacted]"; "i")
  | gsub("(?<![A-Za-z0-9])(?:sk-|ghp_|gho_|ghs_|github_pat_|xox[abpr]-|AKIA|ASIA)[A-Za-z0-9_-]*"; "[redacted]")
  | gsub("[A-Za-z0-9+/=_-]{32,}"; "[redacted]");
def summarize:
  tostring | one_line | . as $flat | scrub as $s
  | {r: ($s != $flat),
     t: (if ($s | u16) > 160 then ($s | .[0:157] | until(u16 <= 157; .[0:(length - 1)])) + "..." else $s end)};
JQ

ev_pick_id() { # the model's call id: the id shown, unique in this turn and safe to match on
  local want=$1
  ev_calls=$((ev_calls + 1))
  if [[ $want =~ ^[A-Za-z0-9_-]{1,64}$ ]] && [[ $ev_used_ids != *" $want "* ]]; then
    ev_cid=$want
  else
    ev_cid=call_$ev_calls
    while [[ $ev_used_ids == *" $ev_cid "* ]]; do ev_cid+=_; done
  fi
  ev_used_ids+="$ev_cid "
}

ev_tool_call() { # name arguments-json
  ev --arg id "$ev_cid" --arg n "$1" --arg a "$2" --argjson r "$ev_round" "$SECRETS_JQ $SUMMARY_JQ"'
    ($a | (try fromjson catch {}) | if type == "object" then . else {} end) as $o
    | (if $n == "run" then $o.command elif $n == "read_file" then $o.path else $n end // "") as $raw
    | ($raw | summarize) as $s
    | {type: "tool_call", round: $r, call_id: $id, name: (if $n == "run" or $n == "read_file" then $n else "other" end),
       summary: $s.t, redacted: $s.r}'
}

ev_tool_result() { # duration-ms: from the facts run_tool left in $work/tool_meta
  local status=error code=null bytes=0 cut=false
  read -r status code bytes cut <"$work/tool_meta" 2>/dev/null || true
  ev --arg id "$ev_cid" --arg s "$status" --argjson e "$code" --argjson d "$1" --argjson b "$bytes" --argjson c "$cut" \
    --argjson r "$ev_round" '{type: "tool_result", round: $r, call_id: $id, status: $s, exit_code: $e,
      duration_ms: $d, output_bytes: $b, output_cut: $c}'
}

ev_answer() { # stop-reason: the terminal line, text cut to the contract's caps
  ev --rawfile t "$work/answer" --arg sr "$1" --argjson rounds "$ev_round" --argjson tc "$ev_calls" "$SECRETS_JQ"'
    def u16: explode | map(if . >= 65536 then 2 else 1 end) | add // 0;
    def wire: explode | map(if . < 128 then (if . == 34 or . == 92 or . < 32 then 6 else 1 end) elif . < 65536 then 6 else 12 end) | add // 0;
    ($t | redact(secrets) | rtrimstr("\n") | .[0:32768]
      | until(u16 <= 32768 and wire <= 260000; .[0:((length * 9 / 10) | floor)])) as $x
    | {type: "answer", text: $x, stop_reason: $sr, rounds: $rounds, tool_calls: $tc}'
  ev_done=1
}

wait_for_server_events() {
  if curl -fsS -o /dev/null "${BASE_URL%/v1}/health" 2>/dev/null; then
    return 0
  fi
  ev '{type: "thinking", round: 1, phase: "warming"}'
  for _ in $(seq 1 "${LFM3_WAIT:-120}"); do
    if curl -fsS -o /dev/null "${BASE_URL%/v1}/health" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  ev_fail model_unavailable 1
}

ask_model_stream() { # with-tools [sampling]: the reply message goes to $work/msg, delta lines to stdout
  local line rc code
  build_body "$1" "" "${2:-}"
  jq '. + {stream: true}' "$work/body" >"$work/body.stream"
  rm -f "$work/end" "$work/curl_rc" "$work/hdr" "$work/raw"
  while IFS= read -r line; do
    case "$line" in
      '{"_end":'*) printf '%s' "$line" >"$work/end" ;;
      *) ev_emit "$line" || ev_fail internal 1 ;;
    esac
  done < <({ curl -sS -N -D "$work/hdr" --max-time "${LFM3_TIMEOUT:-600}" \
      -H 'Content-Type: application/json' -H "Authorization: Bearer ${MODEL_API_KEY:-local}" \
      --data-binary @"$work/body.stream" "$BASE_URL/chat/completions" 2>/dev/null
    echo "$?" >"$work/curl_rc"; } | tee "$work/raw" | jq -n -R -c -a --unbuffered --argjson round "$ev_round" "$SECRETS_JQ $STREAM_JQ")
  rc=$(cat "$work/curl_rc" 2>/dev/null || echo 1)
  code=$(grep -a '^HTTP/' "$work/hdr" 2>/dev/null | tail -n 1 | cut -d' ' -f2 | tr -d '\r' || true)
  if [ "$rc" -ne 0 ] || [ "$code" != 200 ] || ! jq -e '._end.done == true and (._end.err | not)' "$work/end" >/dev/null 2>&1; then
    # As in the plain path: a tool call that ran past the token cap is answered without tools.
    if [ "$1" = 1 ] && grep -aq 'parse tool call' "$work/raw" 2>/dev/null; then
      return 3
    fi
    if [ "$code" != 200 ] && [ -n "$code" ] && grep -aqi 'context' "$work/raw" 2>/dev/null; then
      ev_fail context_too_long 1
    fi
    ev_fail model_failed 1
  fi
  # Reasoning blocks are not part of the reply (section 6).
  jq '._end | {choices: [{message: {role: "assistant", tool_calls: .tool_calls,
      content: (.content | if test("<think") then (gsub("<think>[\\s\\S]*?</think>"; "") | gsub("<think[\\s\\S]*$"; "") | sub("^\\s+"; "")) else . end)},
      finish_reason: .finish}]}' "$work/end" >"$work/out"
  jq -r '._end.finish // ""' "$work/end" >"$work/finish"
  normalize_reply
}

one_turn() { # message
  local text=$1 round=0 with calls i id name args result looped ask stop_reason started finished tool_rounds=0
  if [ -z "$text" ] && [ "$(jq length "$work/parts")" -eq 0 ]; then
    usage
  fi
  jq -n --arg t "$text" --slurpfile names "$work/names" '
    ($names[0] | map("[" + . + "]") | join(" ")) as $n
    | [{role: "user", content: ([$n, $t] | map(select(. != "")) | join(" "))}
       + (if $n == "" then {} else {media: true} end)]' >"$work/user_stored"
  jq -n --arg t "$text" --slurpfile parts "$work/parts" '
    [{role: "user", content: (if ($parts[0] | length) == 0 then $t
      else $parts[0] + (if $t == "" then [] else [{type: "text", text: $t}] end) end)}]' >"$work/user_sent"
  echo '[]' >"$work/turn"

  ask=ask_model
  if [ -n "$events" ]; then
    ask=ask_model_stream
    ev --arg m "$MODEL_NAME" --argjson t "$([ -n "$tools" ] && echo true || echo false)" \
      '{type: "start", model: ($m | .[0:64]), tools: $t}'
    wait_for_server_events
  else
    wait_for_server
  fi
  while :; do
    if [ -n "$tools" ] && [ "$round" -lt "$STEPS" ]; then
      with=1
    else
      with=0
    fi
    if [ -n "$events" ]; then
      ev_round=$((ev_round + 1))
      ev --argjson r "$ev_round" '{type: "thinking", round: $r, phase: "working"}'
    fi
    if ! "$ask" "$with" "$(round_sampling "$with")"; then
      round=$STEPS
      continue
    fi
    calls=$(jq '(.tool_calls // []) | length' "$work/msg")
    if [ "$calls" -eq 0 ] || [ -z "$tools" ] || [ "$round" -ge "$STEPS" ]; then
      break
    fi
    round=$((round + 1))
    tool_rounds=$((tool_rounds + 1))
    jq --slurpfile m "$work/msg" \
      '. + [{role: "assistant", content: ($m[0].content // ""), tool_calls: $m[0].tool_calls}]' \
      "$work/turn" >"$work/turn.new"
    mv "$work/turn.new" "$work/turn"
    for ((i = 0; i < calls; i++)); do
      id=$(jq -r --argjson i "$i" '.tool_calls[$i].id // ("call_" + ($i | tostring))' "$work/msg")
      name=$(jq -r --argjson i "$i" '.tool_calls[$i].function.name // ""' "$work/msg")
      args=$(jq -r --argjson i "$i" '.tool_calls[$i].function.arguments // "{}"
        | if type == "string" then . else tojson end' "$work/msg")
      if [ -n "$events" ]; then
        ev_pick_id "$id"
        ev_tool_call "$name" "$args"
        started=$(ev_clock)
        rm -f "$work/tool_meta"
      fi
      result=$(run_tool "$name" "$args")
      if [ -n "$events" ]; then
        finished=$(ev_clock)
        ev_tool_result "$((finished - started))"
      fi
      jq --arg id "$id" --arg name "$name" --arg r "$result" \
        '. + [{role: "tool", tool_call_id: $id, name: $name, content: $r}]' \
        "$work/turn" >"$work/turn.new"
      mv "$work/turn.new" "$work/turn"
    done
  done

  jq -r '.content // ""' "$work/msg" >"$work/answer"
  # A reply of only spaces or newlines is no answer either (ADO 551).
  grep -q '[^[:space:]]' "$work/answer" || echo "(the model gave no answer)" >"$work/answer"
  # A --json answer that parses is kept whole: a list repeats its keys, and a
  # list with one value in every item reads as a loop and would be cut.
  looped=""
  if [ -z "$json" ] || ! jq empty "$work/answer" >/dev/null 2>&1; then
    looped=$(loop_guard "$work/answer")
  fi
  # Keep the turn: history (trimmed the same way), this message, the tool
  # calls and the answer. Written whole, so a failed request leaves no half turn.
  jq --slurpfile stored "$work/user_stored" --slurpfile turn "$work/turn" \
    --rawfile answer "$work/answer" --argjson room "$CONTEXT_CHARS" '
    def drop_turn: (.[1:] | map(.role == "user") | index(true)) as $i
      | if $i == null then [] else .[($i + 1):] end;
    def fit($room): if length == 0 or (tojson | length) <= $room then . else (drop_turn | fit($room)) end;
    ($stored[0] + $turn[0] + [{role: "assistant", content: ($answer | rtrimstr("\n"))}]) as $new
    | fit($room - ($new | tojson | length)) + $new' \
    "$HISTORY" >"$HISTORY.new"
  mv "$HISTORY.new" "$HISTORY"
  if [ "$(jq length "$work/parts")" -gt 0 ]; then
    cp "$work/parts" "$MEDIA_FILE"
  fi
  if [ -n "$events" ]; then
    # The loop explanation is a stop reason, not text; length wins over steps.
    stop_reason=stop
    if [ -n "$looped" ]; then stop_reason=loop
    elif [ "$(cat "$work/finish" 2>/dev/null)" = length ]; then stop_reason=length
    elif [ "$tool_rounds" -ge "$STEPS" ] && [ "$tool_rounds" -gt 0 ]; then stop_reason=steps
    fi
    ev_answer "$stop_reason"
    return 0
  fi
  cat "$work/answer"
  if [ -n "$looped" ]; then
    echo "(Stopped: the model kept repeating itself. Ask again, or start over with --new.)"
  fi
  if [ -n "$speak_file" ]; then
    speak_answer "$work/answer" "$speak_file"
  fi
}

if [ -n "$warm" ]; then
  warm_cache
  exit 0
fi

if [ -z "$prompt" ] && [ "$(jq length "$work/parts")" -eq 0 ]; then
  if [ -t 0 ]; then
    echo "${LFM3_AGENT_NAME:-lfm3-agent}: chatting with $MODEL_NAME. /new starts over, /exit or Ctrl-D ends." >&2
    while IFS= read -r -e -p "you> " line; do
      case "$line" in
        "") continue ;;
        /exit | /quit | exit | quit) break ;;
        /new)
          forget
          default_system >"$SYSTEM_FILE"
          echo '[]' >"$HISTORY"
          echo "(new conversation)" >&2
          continue
          ;;
      esac
      (one_turn "$line") || true
      echo
    done
    exit 0
  fi
  if [ -n "$fresh" ]; then
    echo "${LFM3_AGENT_NAME:-lfm3-agent}: new conversation" >&2
    exit 0
  fi
  usage
fi

one_turn "$prompt"
