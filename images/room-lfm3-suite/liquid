#!/usr/bin/env bash
# liquid [message ...]: the short way to talk to the model in this room. It is
# lfm3-agent under a friendlier name, so every turn joins the same kept
# conversation.
#
#   liquid                          on a terminal: an interactive chat
#   liquid                          anywhere else (one exec): a greeting and examples
#   liquid what is in /work         one turn; the words are the message, no quotes needed
#   liquid hey, what can you do     a leading "hey" is just part of the message
#   liquid --new write a haiku      lfm3-agent's options work the same way
#   liquid --json list 5 fruits     JSON only, held to JSON syntax by the server; no tools
#   liquid --speak reply.wav hello  the answer in text, then spoken into reply.wav (Audio, Omni)
#   liquid --events --turn ID hi    chat events, one JSON line each, for the console (lfm3-agent --events)
#
# d1 (decision) and base models refuse it with exit 2: d1 answers typed
# questions (lfm3-decide) and a base model only continues text (lfm3-ask --raw).
#
# Quote the message when it has characters the shell reads itself, such as an
# apostrophe, "?" or "*": liquid "what's in /work?"
set -euo pipefail

# --events (AB#541): the chat stream for the console. lfm3-agent owns it, refusals
# included: a model that does not chat gets one error line there, not text here.
if [ "${1:-}" = --events ]; then
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  agent=$here/lfm3-agent
  [ -x "$agent" ] || agent=lfm3-agent
  LFM3_AGENT_NAME=liquid exec "$agent" "$@"
fi

if [ "${LFM3_KIND:-chat}" = decision ]; then
  echo "liquid: ${MODEL:-this model} is a decision model; ask it typed questions with lfm3-decide" >&2
  exit 2
fi
case "${MODEL:-}" in
  *-base)
    echo "liquid: $MODEL is a base model and cannot chat or use tools; continue text with lfm3-ask --raw \"...\"" >&2
    exit 2
    ;;
esac

if [ "$#" -eq 0 ] && [ ! -t 0 ]; then
  # The attachment example follows what this room's model takes (the image sets MODEL).
  case "${MODEL:-}" in
    *omni* | *-vl-*) attach="liquid --image photo.png what is in this picture" ;;
    *audio*) attach="liquid --audio clip.wav what is said in this clip" ;;
    *) attach="" ;;
  esac
  echo "Hi, I am ${MODEL:-the model in this room}, running inside this sandbox. Ask me anything:"
  echo "  liquid what can you do"
  echo "  liquid what is in /work"
  [ -z "$attach" ] || echo "  $attach"
  echo "I remember the conversation; liquid --new starts over. On a terminal, liquid alone opens a chat."
  exit 0
fi

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
agent=$here/lfm3-agent
[ -x "$agent" ] || agent=lfm3-agent
LFM3_AGENT_NAME=liquid exec "$agent" "$@"
