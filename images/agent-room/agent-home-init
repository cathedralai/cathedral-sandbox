#!/bin/sh
# Make /workspace/home for the agent. agent-room-init runs this as root through
# sudo at room start; it is the only command the agent may run with sudo. The
# path is fixed and the sudo rule allows no arguments.
#
# /workspace is owned by root in the image and on a workspace mount, so the
# agent cannot put a symlink at /workspace/home; the check below is for a
# workspace that a root exec changed.
set -eu
home=/workspace/home
if [ -L "$home" ]; then
    echo "agent-home-init: $home is a symlink, not changing it" >&2
    exit 1
fi
mkdir -p "$home"
chown agent:agent "$home"
chmod 0700 "$home"
