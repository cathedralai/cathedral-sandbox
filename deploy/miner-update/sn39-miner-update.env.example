# Which signed channel this miner follows. Public miners follow stable.
CATHEDRAL_MINER_UPDATE_CHANNEL=stable
# The signed release record for that channel. Digest-pinned images inside it
# are what actually gets installed; this URL only carries the signed record.
CATHEDRAL_MINER_UPDATE_URL=https://raw.githubusercontent.com/cathedralai/cathedral-sandbox/release-channel/sn39-snp-miner/stable.json
