[Unit]
Description=Cathedral miner update check, 15 minutes after boot then hourly

[Timer]
# Matches the validator's published cadence so operators learn one number.
# Jitter keeps a fleet from arriving at the channel in lockstep.
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true
Unit=cathedral-miner-update.service

[Install]
WantedBy=timers.target
