[Unit]
Description=Cathedral SN39 miner signed update check
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/cathedral/sn39-miner-update-keys.json

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/cathedral/sn39-miner-update.env
ExecStart=/usr/local/sbin/cathedral-sn39-miner-update check \
  --product ${CATHEDRAL_MINER_UPDATE_PRODUCT} \
  --channel ${CATHEDRAL_MINER_UPDATE_CHANNEL} \
  --channel-url ${CATHEDRAL_MINER_UPDATE_URL}
# The updater rewrites one pin file and restarts one unit. It never needs the
# validator-access material the miner itself reads, so that path is hidden.
InaccessiblePaths=-/etc/cathedral/validator-access
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/cathedral /var/lib/cathedral-sn39-miner-update
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=1200s
