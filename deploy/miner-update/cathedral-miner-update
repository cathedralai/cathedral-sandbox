#!/bin/sh
# Frozen entry point for the Cathedral miner updater.
#
# The bootstrap installs this file once, and no release ever replaces it; the
# updater's unit mounts its directory read-only. It reads no settings from the
# environment and calls every program by absolute path.
#
# It runs the current updater. Unless that exits 0 (done), 11 (halted for an
# operator) or 12 (alert), it asks the previous updater to judge the current
# one (`fallback`). The previous updater acts only if the current one could not
# fetch and verify the channel, or faulted, and it can itself fetch and verify
# the channel against the host's trust set. It then counts a strike, and after
# two it makes itself current again. So a broken or buggy-but-signed updater
# cannot strand a host, and a failure the channel causes demotes nothing.
#
# Exit statuses: 0 done, 10 refused, 11 halted, 12 alert, 13 updater fault.
set -u

INSTALL=/usr/local/lib/cathedral-miner-update
PYTHON=/usr/bin/python3
READLINK=/usr/bin/readlink
ENV=/usr/bin/env

run() {
  release=$("$READLINK" -e -- "$INSTALL/updater/$1") || return 127
  shift
  # `python -m` puts the working directory first on sys.path, so run from the
  # release's own code directory: a caller's directory can never shadow it.
  (cd -- "$release/updater" || exit 127
  exec "$ENV" -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 PYTHONSAFEPATH=1 \
    PYTHONPATH="$release/updater" \
    CATHEDRAL_MINER_UPDATE_RELEASE="$release" \
    "$PYTHON" -s -B -m cathedral.miner_update_cli "$@")
}

run current "$@"
status=$?
[ "${1:-}" = check ] || exit "$status"
case "$status" in
  0|11|12) exit "$status" ;;
esac
# Killed by a signal, for example a systemd timeout: not a fault in the code.
[ "$status" -gt 128 ] && exit "$status"
"$READLINK" -e -- "$INSTALL/updater/previous" >/dev/null || exit "$status"
run previous fallback --current-status "$status"
