# /etc/cathedral-anchor/refresh.env (root, 0600). Paths and URLs only: never
# put key material here. The hotkey seed lives in its own file, root 0600.

# Public origin the offer advertises (the miner hotel's SEALED_MINER_PUBLIC_PORT).
HOTEL_OFFER_ORIGIN=https://203.0.113.9:9443
# Where this host reads GET /room/attestation: the guest address and its
# SEALED_MINER_TLS_PORT (sealed.env SEALED_GUEST_IP). The TLS key check applies.
HOTEL_OFFER_ATTESTATION_URL=https://10.215.0.2:18443
# Polaris offer intake.
HOTEL_OFFER_POST_URL=https://api.polaris.computer/v1/cathedral/snp/hotel-offers
# The anchored UID's hotkey (plaintext Bittensor hotkey file or 0x hex seed), root 0600.
HOTEL_OFFER_HOTKEY_FILE=/etc/cathedral-anchor/hotkey
# The last posted offer (binding_sha256, sequence). Losing it costs one extra post.
HOTEL_OFFER_STATE_FILE=/var/lib/cathedral-anchor/offer-state.json

# Optional.
#HOTEL_OFFER_NETWORK=finney
#HOTEL_OFFER_NETUID=94
#HOTEL_OFFER_POST_ATTEMPTS=4
#HOTEL_OFFER_BACKOFF_SECONDS=15
