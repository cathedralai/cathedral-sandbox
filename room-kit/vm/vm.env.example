# One customer VM (AB#991). vm-ctl.sh create writes this file as
# $VM_ROOT/<name>/vm.env; do not hand-edit a live VM's copy. Read by
# launch-vm.sh (QEMU), vm-net.sh (tap, NAT, SSH forward) and vm_ctl.py.
VM_NAME='example-1'
VM_DIR='/srv/cathedral-vms/example-1'
VM_VCPUS='2'
VM_MEM_GIB='4'
# Size of disk.qcow2, a qcow2 overlay on the pinned base image (images.lock).
VM_DISK_GIB='40'
# Public TCP port on this host forwarded to the guest's port 22. One per VM.
VM_SSH_PORT='22001'
# Link slot n: tap cvm<n>, the n-th /30 of 10.216.0.0/16, host .1, guest .2.
VM_SLOT='0'
VM_TAP='cvm0'
VM_HOST_IP='10.216.0.1'
VM_GUEST_IP='10.216.0.2'
VM_MAC='52:54:00:d8:00:00'
VM_BASE_IMAGE='/srv/cathedral-vms/images/ubuntu-24.04-server-cloudimg-amd64-20261017.img'
VM_BASE_SHA256='04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94'
VM_CREATED_AT='1795600000'
