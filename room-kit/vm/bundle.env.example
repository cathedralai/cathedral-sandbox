# One sealed VM bundle build (build-bundle.sh, AB#999). Copy, edit, then run as root:
#   build-bundle.sh base-root bundle.env
#   build-bundle.sh kernel bundle.env
#   (VM1b: build the VM initrd from build/modules-<release>.tar)
#   build-bundle.sh manifest bundle.env
# Then, per CPU family and vCPU count a host offers, the expected value of one VM:
#   vm_measure.py launch --bundle <out> --identity vm-identity.json --vcpus N --cpu-family genoa
#
# A new, empty directory per bundle. The bundle is addressed by sha256(manifest.json).
VM_BUNDLE_OUT=/srv/vm-bundle-build/out
VM_BUNDLE_LABEL=vm-v1-20261127
# Both package sets come from this snapshot only (snapshot.ubuntu.com, release pocket).
VM_BUNDLE_SUITE=noble
VM_BUNDLE_SNAPSHOT=20261101T000000Z
# The expected packages.lock of each root. A first build sets VM_BUNDLE_LOCK_UPDATE=1,
# reviews the two locks it writes to $VM_BUNDLE_OUT, and commits them as the expectation.
VM_BUNDLE_BASE_LOCK=/srv/vm-bundle-build/base-root.packages.lock
VM_BUNDLE_KERNEL_LOCK=/srv/vm-bundle-build/kernel.packages.lock
VM_BUNDLE_LOCK_UPDATE=0
# The AmdSev firmware, copied into the bundle. VM_BUNDLE_OVMF_SOURCE defaults to the
# owning package and version (dpkg -S); set it when the file has no package.
VM_BUNDLE_OVMF=/usr/share/ovmf/OVMF.amdsev.fd
#VM_BUNDLE_OVMF_SOURCE=ovmf=2024.02-2
# The VM initrd from the VM1b recipe, and its version string.
VM_BUNDLE_INITRD=/srv/vm-bundle-build/cathedral-vm-initrd.cpio.zst
VM_BUNDLE_INITRD_VERSION=vm1-0
# genoa (QEMU -cpu EPYC-Genoa-v1) or turin (EPYC-v4). One bundle per family: build the
# manifest step again into another VM_BUNDLE_OUT, with the same files, for the other one.
VM_BUNDLE_CPU_FAMILY=genoa
# The host QEMU the measurement is for (its VMSA layout).
VM_BUNDLE_QEMU_VERSION=10.2.1
