# Room kit configuration. Copy to room.env and edit. No secrets in this file.
ROOM_ID=room-a                         # unit names: $ROOM_ID.service, $ROOM_ID-docker.service, ...
ROOM_HOSTNAME=hotel-a.example        # TLS name. DNS A record must point here before install.
ROOM_ACME_EMAIL=                       # optional
ROOM_CUSTOMER=GUEST_ID                 # project label for the API key
ROOM_REGION=EU                         # declared at GET /v1/status
API_PROFILE=v1                         # profiles/<name>.sh
ROOM_API_KEY_FILE=/root/room-api-key   # file with the key only (32+ chars, [A-Za-z0-9_-]); read at install
ROOM_API_PORT=18090                    # 127.0.0.1 only
ROOM_HEALTH_PORT=18091                 # 127.0.0.1 only; public at https://$ROOM_HOSTNAME/room/health
ROOM_PUBLIC_PORT=443
ROOM_TLS=on                            # off: no Caddy and no public port; reach the API through a front desk or SSH tunnel
ROOM_REGISTRY_MIRRORS="https://mirror.gcr.io"   # pull Docker Hub images through a mirror (no anonymous Docker Hub rate limit)

# Data volume for guest images, layers and /work. Give a spare disk (it is wiped)
# or a loop image path. Both become xfs with project quota, mounted without nodev.
ROOM_DATA_DIR=/srv/room-a
ROOM_DATA_DEVICE=                      # e.g. /dev/nvme2n1 (needs ROOM_DATA_DEVICE_WIPE=yes)
ROOM_DATA_DEVICE_WIPE=no
ROOM_DATA_IMG=/var/lib/room-a-data.img
ROOM_DATA_SIZE_GB=800                  # sparse; blocks are used only when written

# Guest network: a private bridge, NAT out, no access to the host, link-local or private ranges.
ROOM_BRIDGE=pqbr0
ROOM_BRIDGE_CIDR=10.213.0.1/22                # one IP per sandbox: a /22 holds 1,021 guests, a /24 only 253
ROOM_BRIDGE_PORT_CAP=1023              # a Linux bridge takes at most 1,024 ports ("exchange full"); 0 = no cap (only for rooms with network "none")
ROOM_DNS="1.1.1.1 8.8.8.8"
ROOM_RUNSC_FLAGS="--platform=systrap --overlay2=none --net-raw"   # overlay2=none: snapshot/fork and disk quota see rootfs writes. net-raw: iptables for Docker in the guest
ROOM_ALLOW_DIND=1                      # docker:*-dind images start --privileged (inside gVisor)
# Inner dockerd for docker:*-dind rooms under gVisor (no nat table, no addrtype match):
ROOM_DIND_DOCKERD_ARGS="--iptables=false --ip6tables=false --bridge=none --default-network-opt bridge=com.docker.network.advertise_addr_nmsgs=0 --default-address-pool base=10.200.0.0/14,size=24"
ROOM_DIND_ENV="PATH=/usr/local/sbin/.iptables-legacy:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Sizing (size.py). Default shape 1 vCPU / 4 GiB / 10 GiB.
SHAPE_VCPU=1
SHAPE_MEM_GIB=4
SHAPE_DISK_GIB=10
RESERVE_RAM_PCT=12
RESERVE_THREADS=2
DISK_MAX_FILL_PCT=70
CPU_OVERCOMMIT=1.0
MEM_OVERCOMMIT=1.0
DISK_OVERCOMMIT=1.0
ROOM_MAX_SLOTS=0                       # 0 = no operator cap
ROOM_CREATES_PER_MINUTE=100            # API create pace per key; raise it for a broker that sends bursts
ROOM_GC_PARALLELISM=16                 # parallel docker rm in the API garbage collector
