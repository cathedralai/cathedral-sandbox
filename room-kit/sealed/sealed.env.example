# Sealed hotel: one AMD SEV-SNP guest on this host, with the room kit inside.
# Copy to sealed.env, set the values, run: sudo ./install.sh --sealed sealed.env

# Hotel name: the broker hotel id and the name in every receipt. It reaches the guest
# through QEMU fw_cfg at boot and is not part of the measurement.
SEALED_NAME=sealed-1
# Work directory on the host (guest build, image files, scratch disk, logs).
SEALED_DIR=/srv/sealed-hotel

# Guest shape. The vCPU count and CPU model are part of the SNP measurement.
SEALED_VCPUS=96
SEALED_MEM_GIB=384
# EPYC-Genoa-v1 gives the guest AVX-512 and needs a Zen 4 host (EPYC 9004). Set EPYC-v4
# for a baseline hotel (no AVX-512, any SNP host). Do not use other names: sev-snp-measure
# 0.0.12 must know the model. QEMU, the measurement and the manifest all read this value.
SEALED_CPU_MODEL=EPYC-Genoa-v1
# Scratch disk (sparse file, encrypted inside the guest with a key the host never sees).
# Leave at least SEALED_MIN_HOST_FREE_GIB free on the host file system after the scratch is full.
SEALED_SCRATCH_GIB=900
SEALED_MIN_HOST_FREE_GIB=600
# Persistent data volume for workspaces (docs/SEALED_DATA_VOLUME.md): a second sparse
# file, LUKS2 inside the guest with a key only this build on this machine can make
# (SNP derived key, measurement and policy, plus HOST_DATA). Workspaces then outlive
# a restart of the same build. 0: no data disk; workspaces live on the scratch and
# end at the next boot. Needs SEALED_ROOM_WORKSPACES=1. Part of the measured room.env.
# The size is fixed when data.raw is made.
SEALED_DATA_GIB=0
# A new build cannot open an older build's volume. Before a roll that changes the
# measurement, policy or HOST_DATA, write the choice to $SEALED_DIR/data-on-new-build
# (one line, consumed by the run that uses it):
#   reset  move data.raw to data.raw.prev and start empty (refuses to overwrite an
#          existing data.raw.prev unless SEALED_DATA_OVERWRITE_PREV=1)
#   keep   leave data.raw; workspaces stay on the scratch until a reset or a rekey
# install.sh --sealed stops and asks when neither the identity matches nor a choice
# is set. See docs/SEALED_DATA_VOLUME.md.

# Host <-> guest link (a tap device, NAT to the internet, nothing inbound).
SEALED_TAP=snp0
# The host IP, guest IP, guest MAC and DNS are image constants (guest-constants.sh),
# the same on every host, so they are not set here and do not change the measurement.

# Guest root file system (built with mmdebstrap, packed into the measured initrd).
SEALED_SUITE=resolute
SEALED_MIRROR=http://archive.ubuntu.com/ubuntu
# Firmware: OVMF AmdSev build (direct kernel boot, kernel hashes measured).
SEALED_OVMF=/usr/share/ovmf/OVMF.amdsev.fd

# Room settings inside the guest (same keys as room.env.example).
SEALED_ROOM_MAX_SLOTS=1000
SEALED_ROOM_NETS="10.214.0.0/22 10.214.4.0/22"
# 1: persistent workspaces (#305). On the data volume when SEALED_DATA_GIB > 0;
# else on the dm-crypt scratch, whose key is made at boot, so until the guest restarts.
# Part of the measured room.env: changing it changes the measurement.
SEALED_ROOM_WORKSPACES=0
# Escape Room nonce plant inside the guest. 1 only on Escape hotels.
# A rebuild is required for the plant route (Mr Spock / pin move).
SEALED_ROOM_ESCAPE=0
SEALED_ROOM_ESCAPE_ALLOW_PLAINTEXT=0
# 1: customer-sealed secrets (AB#417, docs/SEALED_SECRETS.md). The front makes a
# per-boot X25519 key, names it in the binding (REPORT_DATA covers it), opens
# envelopes sealed to it, and writes /run/secrets in the room (guest tmpfs, read-only
# in the room). Part of the measured room.env: changing it changes the measurement.
# Needs a pool-room API tarball with the /run/secrets mount (CATHEDRAL_COMMIT).
SEALED_ROOM_SEALED_SECRETS=0
# 1: customer-sealed commands (AB#417, docs/SEALED_COMMANDS.md). The front makes a per-boot
# X25519 key, names it in the binding (REPORT_DATA covers it), opens execs sealed to it and
# seals each answer to the client's key. Part of the measured room.env: changing it changes
# the measurement. Needs a pool-room API tarball that keeps sealed execs out of the exec
# history and logs (CATHEDRAL_COMMIT).
SEALED_ROOM_SEALED_EXEC=0
# AB#650 Gate S.1: hotel-side builds on shared sealed hotels (Option A).
# Profile v1 sets CATHEDRAL_SHARED_HOTEL_BUILDS=refuse when ROOM_RECEIPTS=1.
# ROOM_SHARED_HOTEL_BUILDS=allow  # only if product re-opens builds (not Gate S.1)

# Hotel API key file on the host (the broker's hotel key). The guest gets it
# through QEMU fw_cfg at boot. It is not part of the measurement.
# Not used by a miner hotel (SEALED_MINER=1): the host holds no hotel key.
SEALED_API_KEY_FILE=/etc/thin-broker/hotel-sealed-1.key

# Miner hotel (founding-miner hotels, AB#57). 0: a config hotel, exactly as
# before. 1: the guest makes its own TLS key and an install key at boot and
# names both in the attested binding; it serves the hotel API over HTTPS on
# SEALED_MINER_TLS_PORT with that key; plain HTTP on the tap serves
# /room/attestation only; the hotel key comes only from the control plane,
# sealed to the guest and signed by a key in SEALED_HOTEL_KEY_INSTALL_SIGNERS.
# SEALED_MINER, SEALED_MINER_TLS_PORT and the signers go into the measured
# room.env: changing them changes the measurement. See README "Miner hotel".
SEALED_MINER=0
SEALED_MINER_TLS_PORT=18443
# Public TCP port on the host forwarded to the guest's HTTPS port (host-net.sh).
# Not measured. The hotel offer names https://<public ip>:<this port>.
SEALED_MINER_PUBLIC_PORT=9443
# Control plane install signers: 1 to 4 base64 Ed25519 public keys (raw 32
# bytes), separated by spaces. Published by Cathedral.
SEALED_HOTEL_KEY_INSTALL_SIGNERS=

# Dedicated machine (one owner). Empty: a shared machine, as before.
# A file with the 32 RAW bytes of the owner's Ed25519 public key (not base64,
# not PEM; owner_sign.py --public --raw-out writes it). Then HOST_DATA =
# sha256("cathedral-dedicated-v1\0" || sha256(manifest.json) || key), the
# guest gets the key in fw_cfg, refuses to serve if HOST_DATA does not name
# it, and refuses every room create the owner did not sign. The new HOST_DATA
# must be in the broker's sealed_host_data (install prints it). Changing the
# owner means a relaunch: a new guest, new memory, new receipt key.
SEALED_OWNER_PUBKEY_FILE=

# Debug access. Empty: no login of any kind into the guest (production).
# A public key here enables root SSH from the host on the tap link and adds
# cathedral.debug=1 to the kernel command line, so the measurement shows it.
SEALED_DEBUG_SSH_PUBKEY=
