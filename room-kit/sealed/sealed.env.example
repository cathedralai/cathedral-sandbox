# Sealed hotel: one AMD SEV-SNP guest on this host, with the room kit inside.
# Copy to sealed.env, set the values, run: sudo ./install.sh --sealed sealed.env

# Hotel name: the broker hotel id and the name in every receipt.
SEALED_NAME=sealed-1
# Work directory on the host (guest build, image files, scratch disk, logs).
SEALED_DIR=/srv/sealed-hotel

# Guest shape. The vCPU count and CPU model are part of the SNP measurement.
SEALED_VCPUS=96
SEALED_MEM_GIB=384
SEALED_CPU_MODEL=EPYC-v4
# Scratch disk (sparse file, encrypted inside the guest with a key the host never sees).
# Leave at least SEALED_MIN_HOST_FREE_GIB free on the host file system after the scratch is full.
SEALED_SCRATCH_GIB=900
SEALED_MIN_HOST_FREE_GIB=600

# Host <-> guest link (a tap device, NAT to the internet, nothing inbound).
SEALED_TAP=snp0
SEALED_HOST_IP=10.215.0.1
SEALED_GUEST_IP=10.215.0.2
SEALED_GUEST_MAC=52:54:00:5e:a1:ed
SEALED_DNS="1.1.1.1 8.8.8.8"

# Guest root file system (built with mmdebstrap, packed into the measured initrd).
SEALED_SUITE=resolute
SEALED_MIRROR=http://archive.ubuntu.com/ubuntu
# Firmware: OVMF AmdSev build (direct kernel boot, kernel hashes measured).
SEALED_OVMF=/usr/share/ovmf/OVMF.amdsev.fd

# Room settings inside the guest (same keys as room.env.example).
SEALED_ROOM_MAX_SLOTS=1000
SEALED_ROOM_NETS="10.214.0.0/22 10.214.4.0/22"

# Hotel API key file on the host (the broker's hotel key). The guest gets it
# through QEMU fw_cfg at boot. It is not part of the measurement.
SEALED_API_KEY_FILE=/etc/thin-broker/hotel-sealed-1.key

# Debug access. Empty: no login of any kind into the guest (production).
# A public key here enables root SSH from the host on the tap link and adds
# cathedral.debug=1 to the kernel command line, so the measurement shows it.
SEALED_DEBUG_SSH_PUBKEY=
