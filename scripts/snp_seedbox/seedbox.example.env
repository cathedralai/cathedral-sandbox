# #1469 seed-box host env (example only — fill with owner-reviewed pins; never invent digests)
#
# Contabo fence: do not set LIVE_OK / EXECUTE until Ditto seal ends 2026-10-23 (or Fred frees the slot).
# See docs/SNP_SEEDBOX_CONTABO_OFFLINE_PREP.md

# CATHEDRAL_SEEDBOX_LIVE_OK=yes
# CATHEDRAL_CUSTOMER_GUEST_EXECUTE=yes

# Absolute path + sha256 of the reviewed Contabo/INBOX customer start script.
# CATHEDRAL_CUSTOMER_START_SCRIPT=/root/inbox/cathedral-customer-guest-start.py
# CATHEDRAL_CUSTOMER_START_SCRIPT_SHA256=

# Identity hotkey must equal the miner hotkey on this chip (join key).
# CATHEDRAL_MINER_HOTKEY=
# CATHEDRAL_CUSTOMER_HTTPS_ENDPOINT=203.0.113.10:8444
# CATHEDRAL_CUSTOMER_RUN_DIR=/var/lib/cathedral/snp-seedbox/runs/customer-run-CURRENT

# Optional until Fred publishes (repo@sha256:64hex) — required for step 9 publish later.
# CATHEDRAL_CUSTOMER_IMAGE=

# Supervise layout
# CATHEDRAL_SEEDBOX_RUN_BASE=/var/lib/cathedral/snp-seedbox/runs
# CATHEDRAL_SEEDBOX_ARCHIVE_ROOT=/var/lib/cathedral/snp-seedbox/archive
# CATHEDRAL_SEEDBOX_SPARE_SCRATCH=/var/lib/cathedral/snp-seedbox/spare/scratch.raw

# Miner guest stays independent (existing run_sn94_snp_miner.sh contract on :8081).
