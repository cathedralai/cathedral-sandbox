# Copy to /etc/cathedral/audit-miner.env as root:root mode 0600.
# Used with examples/systemd/cathedral-audit-miner.service and the signed
# updater. The image pin, network and netuid come from the active signed
# release, so they are not set here.
CATHEDRAL_MINER_HOTKEY=REPLACE_WITH_PUBLIC_MINER_HOTKEY
CATHEDRAL_PUBLIC_ENDPOINT=https://REPLACE_WITH_PUBLIC_IPV4:8081
CATHEDRAL_VALIDATOR_ACCESS_KEYS_DIGEST=sha256:REPLACE_WITH_SNAPSHOT_KEYS_FILE_DIGEST
