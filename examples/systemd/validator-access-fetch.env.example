# Worker only. Copy to /etc/cathedral/validator-access-fetch.env as root:root
# mode 0600. Never place it in /etc/cathedral/validator-access: the worker
# container mounts that directory.

# Where the control host publishes the signed snapshot: an https:// URL, or an
# absolute path your own transfer writes to (world-readable, outside /home).
CATHEDRAL_VALIDATOR_ACCESS_SOURCE=https://REPLACE_WITH_CONTROL_HOST/validator-access.json
# Required, no default: the subnet this worker serves. It must equal the netuid
# the worker image checks. Fetch refuses this placeholder, a snapshot for any
# other subnet, and replacing a live snapshot bound to another subnet.
CATHEDRAL_VALIDATOR_ACCESS_NETUID=<NETUID>
# Required, no default: the chain network name the worker image checks. Fetch
# refuses this placeholder and a snapshot for any other network.
CATHEDRAL_VALIDATOR_ACCESS_NETWORK=<NETWORK>
# Must equal the stake floor fixed in the worker image.
CATHEDRAL_VALIDATOR_ACCESS_MINIMUM_STAKE_RAO=0
# The deployed public-key file and the same pin as the miner's env file.
CATHEDRAL_VALIDATOR_ACCESS_KEYS=/etc/cathedral/validator-access/snapshot-keys.json
CATHEDRAL_VALIDATOR_ACCESS_KEYS_DIGEST=sha256:REPLACE_WITH_SNAPSHOT_KEYS_FILE_DIGEST
# The live file the launcher and worker read.
CATHEDRAL_VALIDATOR_ACCESS_OUT=/etc/cathedral/validator-access/validator-access.json
# Exit 3 with an error-level journal line when the live snapshot has fewer
# seconds left than this. auto is one third of its lifetime.
CATHEDRAL_VALIDATOR_ACCESS_ALARM_BELOW_SECONDS=auto
