# Control host only. Copy to /etc/cathedral/validator-access-refresh.env as
# root:root mode 0600. The seed stays on this host; never copy it to a worker.

# Required, no default: the subnet this miner serves. It must equal the netuid
# the worker image checks. The refresher refuses this placeholder, and refuses
# to replace a published snapshot bound to another subnet.
CATHEDRAL_VALIDATOR_ACCESS_NETUID=<NETUID>
# Required, no default: the chain network name the worker image checks. The
# refresher refuses this placeholder.
CATHEDRAL_VALIDATOR_ACCESS_NETWORK=<NETWORK>
# Must equal the stake floor fixed in the worker image.
CATHEDRAL_VALIDATOR_ACCESS_MINIMUM_STAKE_RAO=0
# Your own Ed25519 snapshot key, from `cathedral_validator_access.py init-key`.
# The seed is owned by cathedral-access, mode 0600, in a mode-0700 directory.
CATHEDRAL_VALIDATOR_ACCESS_SIGNING_KEY_ID=cathedral-validator-access-1
CATHEDRAL_VALIDATOR_ACCESS_SIGNING_KEY_FILE=/var/lib/cathedral-validator-access/signer/snapshot.seed
# The same public-key file and pin the workers use.
CATHEDRAL_VALIDATOR_ACCESS_KEYS=/var/lib/cathedral-validator-access/snapshot-keys.json
CATHEDRAL_VALIDATOR_ACCESS_KEYS_DIGEST=sha256:REPLACE_WITH_SNAPSHOT_KEYS_FILE_DIGEST
# The published file workers fetch. Serve this directory over HTTPS, or push
# the file to each worker with your own transfer.
CATHEDRAL_VALIDATOR_ACCESS_OUT=/var/lib/cathedral-validator-access/publish/validator-access.json
# Snapshot lifetime, 600 to 3600 seconds. generated_at is set 30 seconds back.
CATHEDRAL_VALIDATOR_ACCESS_VALID_SECONDS=900
# Exit 3 with an error-level journal line when the published snapshot has fewer
# seconds left than this. auto is one third of its lifetime.
CATHEDRAL_VALIDATOR_ACCESS_ALARM_BELOW_SECONDS=auto
